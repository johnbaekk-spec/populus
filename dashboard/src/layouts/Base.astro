---
// Shared shell: masthead + notice footer, exactly per the design system
// (Congress Feed.dc.html masthead/footer; Mobile.dc.html fold).
import "@fontsource/source-serif-4/600.css";
import "@fontsource/source-serif-4/700.css";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/500.css";
import "@fontsource/public-sans/600.css";
import "@fontsource/public-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import { getBuildData } from "../lib/data";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  active?: "home" | "congress" | "institutional" | "financials" | "macro" | "methodology";
  /** search-first masthead emphasis (Ticker Unified) — one shell, variant props */
  searchEmphasis?: boolean;
  /** footer variant: the two 13F pages swap the §13107(c) block for the 13F
      caveat (they carry no congressional data); everywhere else is standard */
  footer?: "standard" | "inst13f";
  /** extra <head> markup. Used only by the R25 redirect stubs, which need a
      canonical link and a meta refresh in the document head — the one place a
      page cannot express from its body. */
  head?: string;
}

const { title, description, active, searchEmphasis = false, footer = "standard", head = "" } = Astro.props;
const build = getBuildData();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {head && <Fragment set:html={head} />}
    {/* Machine-readable build markers (R19). Deploy verification PARSES these
        by name and compares the values exactly — never a substring search over
        the footer's free text, which a whole-footer replacement would still
        satisfy. Every page carries them, so a per-page tamper is detectable.
        `code_sha` is the full commit sha in CI (SITE_CODE_SHA); the short git
        fallback is dev-only. */}
    <meta name="populus:build_id" content={build.buildId} />
    <meta name="populus:code_sha" content={build.codeSha} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Pre-paint theme: an explicit choice wins; otherwise the CSS
      // prefers-color-scheme fallback applies. Kept inline to avoid FOUC.
      (function () {
        try {
          var t = localStorage.getItem("populus:theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class:list={["masthead", { "masthead-search-first": searchEmphasis }]}>
      <div class="shell masthead-inner">
        <div class="masthead-left">
          <a href="/" class="brand" aria-label="Public Filings home">
            <Mark class="brand-mark" />
            <span class="brand-name">Public Filings</span>
          </a>
          <nav class="site-nav" id="site-nav" aria-label="Modules">
            <a href="/congress/" aria-current={active === "congress" ? "page" : undefined}>Congress</a>
            <a href="/institutional/" aria-current={active === "institutional" ? "page" : undefined}>Institutional</a>
            <a class="nav-shell" href="/financials/" aria-current={active === "financials" ? "page" : undefined}>Financials <span class="badge-soon">SOON</span></a>
            <a class="nav-shell" href="/macro/" aria-current={active === "macro" ? "page" : undefined}>Macro <span class="badge-soon">SOON</span></a>
            <a href="/methodology/" aria-current={active === "methodology" ? "page" : undefined}>Methodology</a>
          </nav>
        </div>
        <div class="masthead-right">
          <button class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="site-search-box">⌕</button>
          <div class="site-search" id="site-search-box">
            <label for="site-search"><span class="glyph" aria-hidden="true">⌕</span><span class="visually-hidden">Search tickers, members, and filers</span></label>
            <input
              type="search"
              id="site-search"
              placeholder="ticker · member · filer"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-panel-list"
              aria-autocomplete="list"
              aria-haspopup="listbox"
            />
            <kbd class="search-kbd" aria-hidden="true">/</kbd>
            <div class="search-panel" id="search-panel" hidden>
              <div id="search-panel-list" role="listbox" aria-label="Search results"></div>
              <div class="search-panel-foot">free text never leaves this device — the index ships with the build</div>
            </div>
          </div>
          <button class="theme-toggle" aria-label="Switch color theme" hidden>theme</button>
          <button class="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="shell site-footer-inner">
        {footer === "inst13f" ? (
          <div class="footer-block">
            <strong>13F caveat.</strong> Quarter-end long positions in Section
            13(f) securities only; filed up to 45 days late; managers under
            $100M do not file. Not current holdings, not a census, not
            financial advice.
          </div>
        ) : (
          <div class="footer-block">
            <strong>Prohibited uses.</strong> Use of congressional financial-disclosure
            reports for commercial purposes, for determining credit, or for
            solicitation is restricted by 5 U.S.C. § 13107(c). Public Filings republishes
            these public records for transparency and research. Nothing here is
            financial advice.
          </div>
        )}
        <div class="footer-block">
          <strong>Sources.</strong> {footer === "inst13f" ? "SEC EDGAR (public domain)." : "House Clerk PTR · Senate eFD · SEC EDGAR · congress-legislators (CC0) · kadoa seed (MIT)."} Per-source conditions:
          <a href="/legal/DATA-LICENSE.md">DATA-LICENSE ↗</a> ·
          <a href="/legal/NOTICE.txt">NOTICE ↗</a>
        </div>
        {/* No manifest digest is rendered here, or anywhere else (Locked #6,
            R19): the manifest is re-assembled AFTER this site builds, so any
            digest printed by a page is stale by construction — a reader who
            checked it would be told the build is corrupt. The build id names
            the release; `populus verify --build <id>` resolves the manifest
            from it. The <meta> markers above are the machine-readable copy. */}
        <div class="footer-build">
          build {build.buildId} · code {build.codeSha}<br />
          no cookies · no account required · no cross-site tracking
        </div>
      </div>
    </footer>

    <script>
      // Masthead behavior shared across pages: theme toggle, mobile nav/search.
      const root = document.documentElement;
      const themeBtn = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const media = window.matchMedia("(prefers-color-scheme: dark)");

      function effectiveTheme(): "light" | "dark" {
        const attr = root.getAttribute("data-theme");
        if (attr === "light" || attr === "dark") return attr;
        return media.matches ? "dark" : "light";
      }
      function paintThemeButton(): void {
        if (!themeBtn) return;
        const next = effectiveTheme() === "dark" ? "light" : "dark";
        themeBtn.textContent = next === "dark" ? "☾ dark" : "☀ light";
        themeBtn.setAttribute("aria-label", `Switch to ${next} theme`);
        themeBtn.hidden = false;
      }
      themeBtn?.addEventListener("click", () => {
        const next = effectiveTheme() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("populus:theme", next);
        } catch {}
        paintThemeButton();
      });
      media.addEventListener("change", paintThemeButton);
      paintThemeButton();

      function wireToggle(btnSel: string, target: Element | null): void {
        const btn = document.querySelector<HTMLButtonElement>(btnSel);
        if (!btn || !target) return;
        btn.addEventListener("click", () => {
          const open = target.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(open));
          if (open && target instanceof HTMLElement)
            target.querySelector<HTMLInputElement>("input")?.focus();
        });
      }
      wireToggle(".nav-burger", document.getElementById("site-nav"));
      wireToggle(".search-toggle", document.getElementById("site-search-box"));
    </script>
    <script>
      import { initSearch } from "../scripts/search-client";
      initSearch();
    </script>

    {/* R36/R28 — Cloudflare Web Analytics. `is:inline` is load-bearing: without
        it Astro would take this into its own bundling, and the whole point is
        that it stays a plain EXTERNAL script with no inline body, so it adds
        nothing to the locked inline-script hash set the CSP pins. `script-src`
        admits static.cloudflareinsights.com and `connect-src` admits
        cloudflareinsights.com; both are in the locked policy in
        `public/_headers`.

        The token is a public value — it ships in the HTML of every page — so it
        is committed rather than injected, and the dashboard has no env-var
        config mechanism to inject it through anyway.

        DEPLOY PRECONDITION: Cloudflare Web Analytics must be set to "Enable
        with JS Snippet installation". Under automatic injection Cloudflare adds
        this same tag at the edge, and shipping it here as well double-counts
        every pageview. Measured 2026-08-19: no beacon was reaching the served
        pages, so nothing is double-counted as of this commit. */}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "5facfb16c7c54d449c7fdd0f0fcc2047"}'
    ></script>
  </body>
</html>
