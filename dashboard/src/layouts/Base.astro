---
// Shared shell: masthead + notice footer. One shell for every surface, varied
// by props — never a second copy. The masthead's 721–1080px intermediate state
// and the ≤720px fold are specified by docs/frontend/design-principles.md §5:
// nothing honesty-bearing may be media-query-hidden, and folded elements use
// the clip pattern so they stay in the accessibility tree.
/* The nine stylesheet regions. IMPORT ORDER IS THE CASCADE, and this list is
   the single source of that order: concatenating these files in exactly this
   sequence is byte-identical to the former single global.css, so the shipped
   cascade is unchanged by the split. late-additions.css MUST stay last — its
   chronological regions override selectors across every earlier file.
   dashboard/test/lib/styles.ts parses THIS block to rebuild the whole-tree
   stylesheet, and dashboard/test/css-fold.test.ts asserts against it, so a
   reordered or added import moves the tests with the cascade rather than
   desyncing from it. Trailing blank lines in these files are region
   separators from the pre-split file and are load-bearing for that byte
   parity — do not strip them. */
import "../styles/foundation.css";
import "../styles/layout.css";
import "../styles/congress-feed.css";
import "../styles/entities.css";
import "../styles/institutional.css";
import "../styles/states-search.css";
import "../styles/content.css";
import "../styles/media.css";
import "../styles/late-additions.css";
import { getBuildData } from "../lib/data";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  active?: "home" | "congress" | "institutional" | "signals" | "watchlist" | "financials" | "macro" | "methodology";
  /** search-first masthead emphasis (Ticker Unified) — one shell, variant props */
  searchEmphasis?: boolean;
  /** footer variant: the three 13F pages (institutional index, filer, ticker
      holders) swap the §13107(c) notice sentence for the 13F caveat sentence —
      they carry no congressional data; everywhere else is standard */
  footer?: "standard" | "inst13f";
  /** extra <head> markup. Used only by the legacy-URL redirect stubs, which need a
      canonical link and a meta refresh in the document head — the one place a
      page cannot express from its body. */
  head?: string;
}

const { title, description, active, searchEmphasis = false, footer = "standard", head = "" } = Astro.props;
const build = getBuildData();

/* The footer's one notice sentence (docs/design/SIGNALS-CLARITY-DECISIONS.md,
   L1). It keeps, on every page, what the former notice paragraph carried: the
   §13107(c) prohibited uses and "not financial advice" — or, on the 13F pages,
   every clause of the 13F caveat. The full notice text, the attributions, the
   sources and their conditions, the privacy statement and the build watermark
   live on /methodology, which the footer links. test/footer.test.ts pins both
   sentences word for word. */
const FOOTER_NOTICE = {
  standard:
    "Not financial advice. Use of congressional disclosure reports for commercial purposes, " +
    "credit decisions or solicitation is restricted by 5 U.S.C. §13107(c).",
  inst13f:
    "13F: quarter-end long positions in Section 13(f) securities only, filed up to 45 days late; " +
    "managers under $100M do not file. Not current holdings, not a census, not financial advice.",
} as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {head && <Fragment set:html={head} />}
    {/* Machine-readable build markers. Deploy verification PARSES these
        by name and compares the values exactly — never a substring search over
        visible text. They are the only per-page statement of the build: the
        visible watermark (`build <id> · code <sha7>`) is printed once, on
        /methodology, and never in the footer. Every page carries them, so a
        per-page tamper is detectable. `code_sha` is the full commit sha in CI
        (SITE_CODE_SHA); the short git fallback is dev-only. */}
    <meta name="populus:build_id" content={build.buildId} />
    <meta name="populus:code_sha" content={build.codeSha} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Pre-paint theme: the former inline IIFE now lives in
        `public/theme-init.js` so `script-src 'self'` carries no inline hash.
        `is:inline` keeps Astro's bundler off it; the tag is synchronous and in
        <head> deliberately — a deferred theme script repaints (FOUC). */}
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <header class:list={["masthead", { "masthead-search-first": searchEmphasis }]}>
      <div class="shell masthead-inner">
        <div class="masthead-left">
          <a href="/" class="brand" aria-label="Public Filings home">
            <Mark class="brand-mark" />
            <span class="brand-name">Public Filings</span>
          </a>
          <nav class="site-nav" id="site-nav" aria-label="Modules">
            <a href="/congress/" aria-current={active === "congress" ? "page" : undefined}>Congress</a>
            <a href="/institutional/" aria-current={active === "institutional" ? "page" : undefined}>Institutional</a>
            <a href="/signals/" aria-current={active === "signals" ? "page" : undefined}>Signals</a>
            <a href="/watchlist/" aria-current={active === "watchlist" ? "page" : undefined}>Watchlist</a>
          </nav>
        </div>
        <div class="masthead-right">
          <button class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="site-search-box">⌕</button>
          <div class="site-search" id="site-search-box">
            <label for="site-search"><span class="glyph" aria-hidden="true">⌕</span><span class="visually-hidden">Search tickers, members, and filers</span></label>
            <input
              type="search"
              id="site-search"
              placeholder="Search members, tickers, managers"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-panel-list"
              aria-autocomplete="list"
              aria-haspopup="listbox"
            />
            <kbd class="search-kbd" aria-hidden="true">/</kbd>
            <div class="search-panel" id="search-panel" hidden>
              <div id="search-panel-list" role="listbox" aria-label="Search results"></div>
              <div class="search-panel-foot">free text never leaves this device — the index ships with the build</div>
            </div>
          </div>

          <button class="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">☰</button>
        </div>
      </div>
    </header>

    <slot />

    {/* One row — brand, three links, the theme toggle — and one notice
        sentence. Nothing here is hidden at any width; at ≤720px the row wraps.
        No manifest digest is rendered here, or anywhere else, deliberately:
        the manifest is re-assembled AFTER this site builds, so a digest printed
        by a page would be stale by construction. */}
    <footer class="site-footer">
      <div class="shell site-footer-inner">
        <div class="footer-row">
          <span class="footer-brand">Public Filings</span>
          <nav class="footer-nav" aria-label="About this site">
            <a href="/methodology/" aria-current={active === "methodology" ? "page" : undefined}>Methodology</a>
            <a href="/methodology/#sources">Sources &amp; licenses</a>
            <a href="/methodology/#notices">Legal</a>
          </nav>
          <button class="theme-toggle" aria-label="Switch color theme" hidden>theme</button>
        </div>
        <p class="footer-notice">{FOOTER_NOTICE[footer]}</p>
      </div>
    </footer>

    <script>
      // Masthead behavior shared across pages: theme toggle, mobile nav/search.
      const root = document.documentElement;
      const themeBtn = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const media = window.matchMedia("(prefers-color-scheme: dark)");

      function effectiveTheme(): "light" | "dark" {
        const attr = root.getAttribute("data-theme");
        if (attr === "light" || attr === "dark") return attr;
        return "dark";
      }
      function paintThemeButton(): void {
        if (!themeBtn) return;
        const next = effectiveTheme() === "dark" ? "light" : "dark";
        themeBtn.textContent = next === "dark" ? "☾ dark" : "☀ light";
        themeBtn.setAttribute("aria-label", `Switch to ${next} theme`);
        themeBtn.hidden = false;
      }
      themeBtn?.addEventListener("click", () => {
        const next = effectiveTheme() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("populus:theme", next);
        } catch {}
        paintThemeButton();
      });
      media.addEventListener("change", paintThemeButton);
      paintThemeButton();

      function wireToggle(btnSel: string, target: Element | null): void {
        const btn = document.querySelector<HTMLButtonElement>(btnSel);
        if (!btn || !target) return;
        btn.addEventListener("click", () => {
          const open = target.classList.toggle("open");
          btn.setAttribute("aria-expanded", String(open));
          if (open && target instanceof HTMLElement)
            target.querySelector<HTMLInputElement>("input")?.focus();
        });
      }
      wireToggle(".nav-burger", document.getElementById("site-nav"));
      wireToggle(".search-toggle", document.getElementById("site-search-box"));
    </script>
    <script>
      import { initSearch } from "../scripts/search-client";
      import { initHitAreas } from "../scripts/hit-areas";
      initSearch();
      // DESIGN-POLISH M1 (H-16): each trigger's hit square stops at the
      // midpoint to its neighbour; an enhancement, never a layout change.
      initHitAreas();
    </script>

    {/* Cloudflare Web Analytics. `is:inline` is load-bearing: without
        it Astro would take this into its own bundling, and the whole point is
        that it stays a plain EXTERNAL script with no inline body, so it adds
        nothing to the locked inline-script hash set the CSP pins. `script-src`
        admits static.cloudflareinsights.com and `connect-src` admits
        cloudflareinsights.com; both are in the locked policy in
        `public/_headers`.

        The token is a public value — it ships in the HTML of every page — so it
        is committed rather than injected, and the dashboard has no env-var
        config mechanism to inject it through anyway.

        DEPLOY PRECONDITION: Cloudflare Web Analytics must be set to "Enable
        with JS Snippet installation". Under automatic injection Cloudflare adds
        this same tag at the edge, and shipping it here as well double-counts
        every pageview. Measured 2026-08-19: no beacon was reaching the served
        pages, so nothing is double-counted as of this commit. */}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "5facfb16c7c54d449c7fdd0f0fcc2047"}'
    ></script>
  </body>
</html>
