---
// D-2 (ALPHA-UX) → signals-v3 M2: /signals is a triage. Every signal still
// renders its exact rule (from its kind word), its magnitude interval, both
// dates and its receipt; withheld kinds render as withheld with their typed
// reason. The head carries three figures and the "How signals work" note; the
// lead cards; then "Filings to read" beside the hit rate by family and the
// slim hits table. The rule book and the lag distribution are on Methodology.
// signals-v4 M2 (R9, R10, LD8, LD9): the page is "Signals", in tabs — Congress
// (the above) and Institutional (the notable managers' named moves,
// Consensus and the new-position leaders, moved here from /institutional/).
// signals-v4 M3 (R18–R22): two more tabs — Overlap (names Congress and the
// notable managers both traded in the quarter, a co-occurrence) and Playbooks
// (published research on the patterns the rows show; not advice).
import Base from "../../layouts/Base.astro";
import { getBuildData, getOverlap, getPlaybookTriggers, getSignalArtifact, getSignalsInstitutional, getTriage } from "../../lib/data";
import { signalsBody, type SignalsPageDeps } from "../../lib/ui/index.ts";
import type { RenderCtx } from "../../lib/format";
import { NAMED_MOVES_FALLBACK_ROWS, SIGNALS_PAGE_BYTES, SIGNALS_PAGE_CHROME_BYTES } from "../../lib/notable-moves";
import { OVERLAP_FALLBACK_ROWS } from "../../lib/ui/signals-overlap";

const build = getBuildData();
const artifact = getSignalArtifact();
const ctx: RenderCtx = {
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
// The hit-rate denominator: rows FILED inside the artifact's own coverage
// window — the same population every rule was evaluated over. Counted here
// because only the page holds the full row set; the artifact carries the
// window bounds it was computed against.
const rowsEvaluated = build.txns.filter(
  (t) => t.filed >= artifact.coverageFrom && t.filed <= artifact.coverageTo,
).length;
// LD1: the triage, the Institutional tab, Overlap and the playbook triggers
// are computed once per build, in memory, and never serialized.
const triage = getTriage();
const institutional = getSignalsInstitutional();
const playbooks = {
  triggers: getPlaybookTriggers(),
  triage,
  bestIdeas: institutional.leaders?.qualifying ?? null,
  consensus: institutional.board?.qualifying ?? null,
  cmteUnavailableReason: triage.cmteUnavailableReason,
};
const deps: SignalsPageDeps = { rowsEvaluated, triage, institutional, overlap: getOverlap(), playbooks };
let body = signalsBody(artifact, ctx, deps);
/* LD11's budget: a page over 2 MiB carries the Named moves' locked
   fallback bound (20 per filter, not 30), and — M3, when that is not enough —
   Overlap's (12 names a view, not 24); each tab states the bound it uses. */
const over = (b: string): boolean => Buffer.byteLength(b) > SIGNALS_PAGE_BYTES - SIGNALS_PAGE_CHROME_BYTES;
if (over(body)) {
  body = signalsBody(artifact, ctx, { ...deps, institutional: getSignalsInstitutional(NAMED_MOVES_FALLBACK_ROWS) });
  if (over(body)) body = signalsBody(artifact, ctx, { ...deps, institutional: getSignalsInstitutional(NAMED_MOVES_FALLBACK_ROWS), overlap: getOverlap(OVERLAP_FALLBACK_ROWS) });
}
// signals-v4 LD9 (reversing SIGNALS-CLARITY M2's R7): the page holds Congress
// AND 13F tabs, so its title, h1 and description name both sources — the
// property kept is that the title names what is on the page.
const description =
  "Signals from Congress trades and 13F filings: the Congress filings to read first, each measured against the filer's " +
  "own record, with the rule-based hits that flagged them — every hit with its exact rule, interval magnitude, both " +
  "dates and receipt — and the notable 13F managers' named moves, consensus and largest new positions for the newest " +
  "closed quarter, each with its 13F receipt and the members of Congress on the same side; the names both traded in " +
  "that quarter; and published research on the patterns the rows show, with evidence on both sides. Not advice.";
---

<Base title="Signals — Congress and 13F — Public Filings" description={description} active="signals">
  <main class="shell page design-page" id="signals-page">
    <Fragment set:html={body} />
  </main>
  <script>
    import { initSignalsPage } from "../../scripts/signals-client";
    import { initDomDisclosures } from "../../scripts/inst-index-client";
    import { initNotes } from "../../scripts/notes";
    initSignalsPage();
    /* Consensus's DOM-backed "Show all" (LD12): the one binder every such
       disclosure on the site uses */
    initDomDisclosures();
    initNotes();
  </script>
</Base>
