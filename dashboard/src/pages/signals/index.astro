---
// D-2 (ALPHA-UX) → signals-v3 M2: /signals is a triage. Every signal still
// renders its exact rule (from its kind word), its magnitude interval, both
// dates and its receipt; withheld kinds render as withheld with their typed
// reason. The head carries three figures and the "How signals work" note; the
// lead cards; then "Filings to read" beside the hit rate by family and the
// slim hits table. The rule book and the lag distribution are on Methodology.
import Base from "../../layouts/Base.astro";
import { getBuildData, getSignalArtifact, getTriage } from "../../lib/data";
import { signalsBody, type SignalsPageDeps } from "../../lib/ui/index.ts";
import type { RenderCtx } from "../../lib/format";

const build = getBuildData();
const artifact = getSignalArtifact();
const ctx: RenderCtx = {
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
// The hit-rate denominator: rows FILED inside the artifact's own coverage
// window — the same population every rule was evaluated over. Counted here
// because only the page holds the full row set; the artifact carries the
// window bounds it was computed against.
const rowsEvaluated = build.txns.filter(
  (t) => t.filed >= artifact.coverageFrom && t.filed <= artifact.coverageTo,
).length;
// LD1: the triage is computed once per build, in memory, and never serialized.
const deps: SignalsPageDeps = { rowsEvaluated, triage: getTriage() };
const body = signalsBody(artifact, ctx, deps);
// R7 (SIGNALS-CLARITY M2): the page is Congress signals in its title, h1 and
// description; the masthead nav label stays "Signals".
const description =
  "Congress signals: the filings to read first, each measured against the filer's own record, with the " +
  "rule-based hits that flagged them — every hit with its exact rule, interval magnitude, both dates and " +
  "receipt; uncalibrated or out-of-envelope kinds are withheld and say so.";
---

<Base title="Congress signals — Public Filings" description={description} active="signals">
  <main class="shell page design-page" id="signals-page">
    <Fragment set:html={body} />
  </main>
  <script>
    import { initSignalsPage } from "../../scripts/signals-client";
    import { initNotes } from "../../scripts/notes";
    initSignalsPage();
    initNotes();
  </script>
</Base>
