---
// /macro module shell. The macro dashboard archetype (chart-heavy small
// multiples) is scheduled for M4; until its data exists this module ships as a
// forward-looking shell only (docs/frontend/design-principles.md §7).
import Base from "../../layouts/Base.astro";

const description =
  "Macro dashboard — planned, revision-aware from day one. Caveats are committed before any data ships.";
---

<Base title="Macro — planned — Public Filings" description={description} active="macro">
  <main class="shell page">
    <div class="module-shell">
      <div class="kicker">/macro · module 4</div>
      <h1 class="shell-title">Macro dashboard — planned, revision-aware from day one.</h1>
      <p class="shell-lede">
        Treasury curve, CPI, employment, and CFTC positioning as small
        multiples. Every series carries vintage semantics: a revised print never
        replaces history silently.
      </p>
      <div class="caveat-box">
        <div class="caveat-box-head">Caveats committed before any data ships</div>
        <div class="caveat-box-body">
          · Series are revised — prior vintages render as labeled ghost strokes<br />
          · BLS-derived surfaces carry the BLS-required citation + disclaimer verbatim<br />
          · Release calendars shown; "latest" always names its as-of date<br />
          · No nowcasts, no forecasts — Public Filings reports records, not predictions
        </div>
      </div>
      <div class="shell-foot">
        <span class="mono-note">gates: vintage fixtures · ToS conditions encoded · budget held</span>
      </div>
    </div>
  </main>
</Base>
