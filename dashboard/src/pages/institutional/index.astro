---
// /institutional landing — fixes the previously-404ing masthead link. With the
// module absent this is the S1 withheld/absent full-page state; with it
// present, an honest filer index over the published registry (identity fields;
// cumulative registry counts are labeled as all-period values — Locked #6).
import Base from "../../layouts/Base.astro";
import { getBuildData, filerTier } from "../../lib/data";
import { s1ModuleAbsent, s7Banner, breadcrumb, addsSectionHtml } from "../../lib/ui";
import { filingWindow } from "../../lib/derive";
import { concentrationFor, deltasFor, typingFor, addsFor, addsExclusionCount } from "../../lib/inst";
import { boundAdds, closedPeriods, type AddsMode } from "../../lib/inst-adds";
import { biggestChange, MANAGER_TYPE_LABELS, type ManagerType } from "../../lib/manager-directory";
import {
  footnoteBlock,
  fmtInt,
  esc,
  compactDisclosure,
  noteBody,
  noteFromHtml,
  terminusRow,
  COMPACT_ROWS,
} from "../../lib/format";
import { activityFeed, activitySectionHtml } from "../../lib/activity";
import {
  buildInstIndexRow,
  instIndexBodyHtml,
  INST_INDEX_HEADS,
  type InstIndexRow,
} from "../../lib/inst-index";

const build = getBuildData();
const inst = build.inst;
const window = inst.present ? filingWindow(build.generatedAtDate) : null;
// RUN M2-8 T13 (R13): the bounded, byte-paginated cross-filer activity feed.
// The §5 data_note ships with it by construction (activitySectionHtml) — the
// feed cannot be rendered without its structural caveat.
const feed = activityFeed({ instPresent: inst.present });

let bodyHtml: string;
if (!inst.present) {
  bodyHtml = s1ModuleAbsent(inst.reason);
} else {
  // A-2: period-correct index rows (constraint 4 — every number from
  // agg_filer_concentration for the filer's latest period, never the
  // registry's cross-period accumulators), ranked by reported 13(f) long
  // value with the no-sentinel rule for missing values.
  const indexRows: InstIndexRow[] = inst.filers.map((f) =>
    buildInstIndexRow(
      f,
      concentrationFor(inst, f.cik, f.latest_period),
      filerTier(build, f.cik),
      // R11: curated typing where the registry has it, null otherwise — the
      // directory types a curated SUBSET and says so rather than guessing.
      typingFor(inst, f.cik),
      // R11/R22: the manager's largest change in its own latest period.
      biggestChange(deltasFor(inst, f.cik, f.latest_period), f.latest_period),
    ),
  );
  /* R7/F2/F3: compact by DEFAULT, server-side, through the SAME renderer the
     client island uses.

     This page used to render the body itself: it sliced the RANKED rows to the
     compact budget and then appended EVERY unranked row after them, outside
     that budget. A directory with 400 unrankable managers therefore rendered
     410 rows while its own disclosure said 10 were shown — the bound was
     announced and then not applied. `instIndexBodyHtml` applies ONE budget
     across both buckets and still states the unranked bucket's size even when
     none of its rows fit, and it is now the only renderer of this table. */
  const directory = instIndexBodyHtml(indexRows, "", "value", "desc", undefined, COMPACT_ROWS);
  const rows = directory.html;
  /* SL-R5: a column with no well-defined order still STATES why — the channel
     changed, not the text. It was a `.col-why` sub-label under every unsortable
     header, which is the single largest contributor to this table's header
     height; it is now a note anchored on that same header, reachable by hover,
     tap, keyboard and print. R26b: the scope is supplied by this caller, and
     the key is the column's own sort key where it has one and its label where
     it does not — this mapper renders exactly once per page. */
  const headNotes = { scope: "inst-index" };
  // SL-R18: declared HERE now, because the Type column's note reads it and the
  // note renders above the chip row that used to be its only consumer.
  const typedCount = indexRows.filter((r) => r.typing !== null).length;
  /* SL-R18: the Type column's note carries BOTH its own unsortability reason
     and the curated-coverage caveat with its live `N of M` count — the two
     facts a reader needs at that column, in one place, instead of a paragraph
     above the table repeating the second. */
  const typeNote =
    `Manager type and display name come from a curated registry covering ` +
    `<strong>${fmtInt(typedCount)} of ${fmtInt(indexRows.length)}</strong> filers in this build. ` +
    `The rest render the name exactly as filed and carry no type — that is a gap in the curation, ` +
    `not a statement that the manager is uncategorised. Automatic classification across the full ` +
    `filer population is future work.`;
  // `h.why` is plain text and is escaped here; `typeNote` is pre-escaped html
  // carrying the `<strong>` emphasis the deleted paragraph published.
  const headNoteBody = (h: (typeof INST_INDEX_HEADS)[number]): string =>
    noteBody(h.why ? esc(h.why) : null, h.label === "Type" ? typeNote : null);
  const heads = INST_INDEX_HEADS.map((h) =>
    h.key == null
      ? `<th scope="col">${esc(h.label)}${
          headNoteBody(h) ? noteFromHtml(headNoteBody(h), headNotes, h.label) : ""
        }</th>`
      : `<th scope="col" data-inst-sort="${h.key}" aria-sort="${h.key === "value" ? "descending" : "none"}"><button class="th-sort">${esc(h.label)}</button></th>`,
  ).join("");

  /* R9/R20: the leaderboard leads the page. Only CLOSED quarters are offered,
     and the newest is the default view — an open quarter counts only the
     managers who happened to file early, so it is not offered at all. */
  const addsPeriods = closedPeriods(inst.addsPeriods, build.generatedAtDate);
  const addsPeriod = addsPeriods[0] ?? null;
  const addsMode: AddsMode = "all";
  const addsHtml =
    addsPeriod === null
      ? `<section class="panel panel-wide" id="inst-adds-section" aria-label="Recently added issuers">` +
        `<div class="panel-head"><h2 class="section-h">Recently added issuers</h2></div>` +
        `<p class="section-note">No reporting quarter in this build has passed its 45-day filing ` +
        `deadline yet, so there is no closed quarter to rank. That is a statement about the ` +
        `calendar, not an absence of data.</p></section>`
      : addsSectionHtml(
          {
            period: addsPeriod,
            generated_at: build.generatedAtDate,
            ...boundAdds(addsFor(inst, addsPeriod, addsMode)),
            ambiguous_identity_exclusion_count: addsExclusionCount(inst, addsPeriod, addsMode),
          },
          { period: addsPeriod, mode: addsMode, periods: addsPeriods, buildId: build.buildId },
        );

  /* R11: the type chips. `Notable` is EDITORIAL and orthogonal — it renders
     beside the type chips but is not one of them, so selecting a type never
     hides a notable manager of that type. */
  const chipsHtml =
    `<div class="mgr-chips" id="mgr-chips" role="group" aria-label="Filter managers">` +
    `<button type="button" class="mgr-chip mgr-chip-notable" data-mgr-notable="1" aria-pressed="false">notable</button>` +
    (Object.keys(MANAGER_TYPE_LABELS) as ManagerType[])
      .map(
        (t) =>
          `<button type="button" class="mgr-chip" data-mgr-type="${esc(t)}" aria-pressed="false">${esc(
            MANAGER_TYPE_LABELS[t],
          )}</button>`,
      )
      .join("") +
    `</div>` +
    /* SL-R18: the curated-coverage caveat moves onto the Type column it is
       about, carrying its `N of M` count with it — see `typeNote` below, which
       is what `headNotes` renders. The `<noscript>` stays visible here, because
       it is about scripting rather than about a column and no column note is
       the right home for it. */
    `<p class="caveat-line"><noscript>Filtering by chip needs JavaScript; every manager is listed below regardless.</noscript></p>`;
  bodyHtml =
    breadcrumb([{ text: "/institutional" }]) +
    `<header class="entity-head"><div class="entity-head-copy">` +
    `<h1 class="entity-title">Institutional 13F</h1>` +
    `<p class="entity-lede">Quarter-end long positions in Section 13(f) securities, filed up to 45 days late, by managers over $100M — never current holdings, never a census. This build's aggregate covers ${fmtInt(
      inst.filers.length,
    )} filers; latest period on record ${esc(inst.watermarks.latest_period_of_report ?? "—")}.</p>` +
    `</div></header>` +
    (window?.open ? s7Banner(window) : "") +
    // R9 -> R10 -> R11: leaderboard, then the issuer-anchored feed, then the
    // typed directory.
    addsHtml +
    activitySectionHtml(feed, { tierOf: (cik) => filerTier(build, cik) }) +
    chipsHtml +
    `<section class="panel panel-wide" id="inst-managers-section" aria-label="Manager directory">` +
    `<div class="panel-head"><h2 class="section-h">Manager directory</h2>` +
    `<span class="panel-note"><input class="filter-select filter-text" type="search" id="inst-index-q" ` +
    `placeholder="filer name or CIK" aria-label="search filers by name or CIK — on this device" /></span></div>` +
    `<p class="section-note"><span id="inst-index-count">${fmtInt(indexRows.length)} filers · sorted by reported 13(f) long value, largest first</span> · ` +
    `each value is the filer's latest period, shown beside it · click a header to re-sort` +
    `<noscript> · sorting and search need JavaScript; the default order below is by value, largest first</noscript></p>` +
    `<div class="table-scroll"><table class="etable" data-sticky-first>` +
    `<caption class="visually-hidden">13F filers ranked by reported 13(f) long value for each filer's latest period</caption>` +
    `<thead><tr>${heads}</tr></thead>` +
    `<tbody id="inst-managers-tbody">${rows}</tbody></table></div>` +
    footnoteBlock(
      [
        {
          mark: "§",
          html:
            `"reported 13(f) long value" is the sum of disclosed long-position values for the stated ` +
            `quarter — it excludes cash, shorts, and non-13(f) assets, so it is NOT a measure of ` +
            `everything the manager runs, and a large multi-asset manager can appear small. Sourced ` +
            `period-correctly from <code>agg_filer_concentration</code>; NULL means the source ` +
            `disclosed no usable value — never zero. HHI renders only over a complete disclosed-value ` +
            `book: with any NULL-valued position the denominator is partial, so the number is withheld ` +
            `from display and ordering rather than shown as false precision`,
        },
      ],
      { id: "inst-index-footnotes" },
    ) +
    /* R19/F6: the named bound beside the compact table. Rendered in both
       states so the client can reveal the sentence and the button together
       when a chip change pushes the row count back over the limit (F16). */
    terminusRow({
      author: "populus",
      hidden: directory.total <= directory.shown,
      html:
        `${fmtInt(Math.max(0, directory.total - directory.shown))} further managers are not ` +
        `rendered above — a Public Filings render bound, not a data bound. Every filer in this ` +
        `build has its own page, reachable from this table once expanded.`,
    }) +
    compactDisclosure({
      rootId: "inst-managers-tbody",
      total: directory.total,
      shown: directory.shown,
      noun: "managers",
    }) +
    `<p class="visually-hidden" id="inst-index-status" role="status" aria-live="polite"></p>` +
    `<script type="application/json" id="inst-index-data">${JSON.stringify(indexRows).replaceAll("</", "<\\/")}</script>` +
    `</section>`;
}
const description = build.inst.present
  ? "Institutional 13F module: filers, holders, quarter-over-quarter moves from the published Public Filings aggregate."
  : "The institutional 13F module is not in this build — absence is stated, not simulated.";
---

<Base
  title="Institutional 13F — Public Filings"
  description={description}
  active="institutional"
  footer="inst13f"
>
  <main class="shell page">
    <Fragment set:html={bodyHtml} />
  </main>

  <script>
    import {
      initInstIndex,
      initAddsControls,
      initDomDisclosures,
    } from "../../scripts/inst-index-client";
    import { initNotes } from "../../scripts/notes";
    initInstIndex();
    initAddsControls();
    initDomDisclosures();
    /* SL-R28: one `initNotes()` per surface that passes a note scope. Binding
       is DELEGATED on `document`, so one call covers notes created later by an
       `innerHTML` replacement — a sort repaint, a page change, a period switch —
       and a second call would be idempotent. It is NOT added to `Base.astro`:
       that would load the module on every page in the site, including the ones
       this run does not touch, for no benefit. Without it a note still OPENS,
       through `popovertarget` alone; what this adds is placement, hover, Escape
       and outside-click. */
    initNotes();
  </script>
</Base>
