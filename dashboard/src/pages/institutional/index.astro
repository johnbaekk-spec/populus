---
// /institutional landing — fixes the previously-404ing masthead link. With the
// module absent this is the S1 withheld/absent full-page state; with it
// present, an honest filer index over the published registry (identity fields;
// cumulative registry counts are labeled as all-period values).
// signals-v4 M2 (R17, LD18): the Named moves, Consensus and the new-position
// leaders moved to /signals/#institutional; this page keeps its head (three
// figures), the provenance line, a one-line pointer, the Filer directory,
// Recent activity and the collapsed "Recently added issuers".
import Base from "../../layouts/Base.astro";
import { getBuildData, filerTier, instDirectoryRows, instDirectoryFamily } from "../../lib/data";
import { disclosureLedger, s1ModuleAbsent, s7CopyHtml, addsSectionHtml } from "../../lib/ui/index.ts";
import { concentrationPeriods, trackedValueFor } from "../../lib/inst-analytics";
import { quarterLabel } from "../../lib/congress-quarter";
import { filingWindow } from "../../lib/derive";
import { serializeInlineJson } from "../../lib/inline-json";
import { addsFor, addsExclusionCount } from "../../lib/inst";
import { corpusAsOf, boundAdds, closedPeriods, instFreshnessText, type AddsMode } from "../../lib/inst-adds";
import { MANAGER_TYPE_LABELS, type ManagerType } from "../../lib/manager-directory";
import {
  fmtInt,
  fmtUsd,
  esc,
  compactDisclosure,
  note,
  noteBody,
  noteFromHtml,
  thHtml,
  COMPACT_ROWS,
  dataColumnsAttr,
} from "../../lib/format";
import { activityFeed, activitySectionHtml } from "../../lib/activity";
import {
  directoryColumns,
  instIndexBodyHtml,
  DESIGN_INST_INDEX_HEADS as INST_INDEX_HEADS,
  type InstIndexRow,
} from "../../lib/inst-index";

const build = getBuildData();
const inst = build.inst;
const window = inst.present ? filingWindow(build.generatedAtDate) : null;
// The bounded, byte-paginated cross-filer activity feed.
// The §5 data_note ships with it by construction (activitySectionHtml) — the
// feed cannot be rendered without its structural caveat.
const feed = activityFeed({ instPresent: inst.present });
// R7: the landing feed is restricted to the registry's `notable` managers.
const notableCiks = new Set<string>(
  inst.present ? [...inst.typingByCik.values()].filter((t) => t.notable).map((t) => t.cik) : [],
);

let bodyHtml: string;
if (!inst.present) {
  bodyHtml = s1ModuleAbsent(inst.reason);
} else {
  // A-2: period-correct index rows (constraint 4 — every number from
  // agg_filer_concentration for the filer's latest period, never the
  // registry's cross-period accumulators), ranked by reported 13(f) long
  // value with the no-sentinel rule for missing values. Launch M7b (R32,
  // LD28): built ONCE per build by `instDirectoryRows`, which the directory
  // shard family reads too, so the first rows below and the fetched shards
  // are the same rows.
  const indexRows: InstIndexRow[] = instDirectoryRows(build);
  /* Compact by DEFAULT, server-side, through the SAME renderer the
     client uses after it fetches the shards.

     This page used to render the body itself: it sliced the RANKED rows to the
     compact budget and then appended EVERY unranked row after them, outside
     that budget. `instIndexBodyHtml` applies ONE budget across both buckets
     and still states the unranked bucket's size even when none of its rows
     fit, and it is the only renderer of this table. */
  /* R12 (DESIGN-POLISH M2; review R2-6): "Top-5" is a derived column that
     exists only when the build's concentration slices hold five positions
     (topn === 5) and some filer carries one; otherwise it is removed outright
     (launch M7b, copy item inst-04: without a "Not shown" line — the column
     carries no honesty field). ONE presence function decides it
     (`directoryColumns`), the set rides in `data-columns`, and the client
     re-render reads it back. The field travels only when the column does. */
  const dirCols = directoryColumns(indexRows, inst.topn);
  const top5Present = dirCols.columns.includes("top5");
  /* Launch M7b (R32, LD28): the rows ship as a versioned shard family the
     client fetches on the first search, chip or sort; the page inlines only
     the shard list (a few hundred bytes), never the rows. */
  const directoryFamily = instDirectoryFamily(build);
  /* R14: *Hedge funds* is selected by default, for every visitor; the client
     island starts from the same pressed chip, so its first render equals this
     one. */
  const DEFAULT_TYPES = new Set<string>(["hedge_fund"]);
  const directory = instIndexBodyHtml(indexRows, "", "value", "desc", { types: DEFAULT_TYPES, notableOnly: false }, COMPACT_ROWS, dirCols.columns);
  const rows = directory.html;
  /* A column with no well-defined order still STATES why — the channel
     changed, not the text. It was a `.col-why` sub-label under every unsortable
     header, which is the single largest contributor to this table's header
     height; it is now a note anchored on that same header, reachable by hover,
     tap, keyboard and print. The scope is supplied by this caller, and
     the key is the column's own sort key where it has one and its label where
     it does not — this mapper renders exactly once per page. */
  const headNotes = { scope: "inst-index" };
  // Declared HERE now, because the Type column's note reads it and the
  // note renders above the chip row that used to be its only consumer.
  const typedCount = indexRows.filter((r) => r.typing !== null).length;
  /* The Type column's note carries BOTH its own unsortability reason
     and the curated-coverage caveat with its live `N of M` count — the two
     facts a reader needs at that column, in one place, instead of a paragraph
     above the table repeating the second. */
  const typeNote =
    `Manager type and display name come from a curated registry covering ` +
    `<strong>${fmtInt(typedCount)} of ${fmtInt(indexRows.length)}</strong> filers in this build. ` +
    `The rest render the name exactly as filed and carry no type — that is a gap in the curation, ` +
    `not a statement that the manager is uncategorised.`;
  /* Launch M7b (copy item inst-05): the § footnote under the table becomes
     the Value header's tip, opened from its § mark — the same § every "n/a ·§"
     cell prints. Every clause a reader needs stays: not AUM, what it
     excludes, n/a is never zero, and a valueless position is counted beside
     the sum (the HHI rule rides each row's own value note). */
  const valueNote =
    `Sum of disclosed 13F long positions for the filer's latest quarter, named in each value's note — ` +
    `not assets under management (no cash, shorts or non-13F assets), so a large multi-asset manager can look small. ` +
    `n/a means no usable value, never zero; a position reported without a value is counted beside the sum, not in it.`;
  // `h.why` is plain text and is escaped here; `typeNote` is pre-escaped html
  // carrying the `<strong>` emphasis the deleted paragraph published.
  const headNoteBody = (h: (typeof INST_INDEX_HEADS)[number]): string =>
    noteBody(h.why ? esc(h.why) : null, h.label === "Filer" ? typeNote : null, h.label === "Value" ? esc(valueNote) : null);
  /* Ledger roles (DESIGN-POLISH M1, R2): the filer name takes the slack. */
  const headClass: Record<string, string> = {
    Filer: "c-filer c-flex", Manager: "c-filer c-flex", CIK: "c-num", Value: "c-num", Pos: "c-num",
    "Top-5": "c-num", "Latest notable": "c-change",
  };
  const heads = INST_INDEX_HEADS.filter((h) => top5Present || h.label !== "Top-5").map((h) =>
    thHtml({
      /* the § mark rides the Value label so `thHtml` hangs it as the tip's
         trigger beside the sort button (inst-05) */
      label: h.label === "Value" ? "Value ·§" : h.label,
      cls: headClass[h.label] ?? "",
      noteHtml: headNoteBody(h) || null,
      notes: headNotes,
      noteKey: h.label,
      sort: h.key == null ? null : { attr: "data-inst-sort", key: h.key, state: h.key === "value" ? "descending" : "none" },
      col: ({ Filer: "filer", CIK: "cik", Value: "value", Pos: "positions", "Top-5": "top5", "Latest notable": "latest-notable" } as Record<string, string>)[h.label],
    }),
  ).join("");

  /* The recently-added issuers supplement: only CLOSED quarters are
     offered, and the newest is the default view — an open quarter counts only
     the managers who happened to file early, so it is not offered at all. */
  const asOf = corpusAsOf(build.generatedAtDate, inst.watermarks.latest_filed_date);
  const addsPeriods = closedPeriods(inst.addsPeriods, asOf);
  const addsPeriod = addsPeriods[0] ?? null;
  const addsMode: AddsMode = "all";
  const addsHtml =
    addsPeriod === null
      ? `<section class="panel panel-wide" id="inst-adds-section" aria-label="Recently added issuers">` +
        `<div class="panel-head"><h2 class="section-h">Recently added issuers</h2></div>` +
        `<p class="section-note">No reporting quarter in this build has passed its 45-day filing ` +
        `deadline yet, so there is no closed quarter to rank. That is a statement about the ` +
        `calendar, not an absence of data.</p></section>`
      : addsSectionHtml(
          {
            period: addsPeriod,
            generated_at: build.generatedAtDate,
            ...boundAdds(addsFor(inst, addsPeriod, addsMode)),
            ambiguous_identity_exclusion_count: addsExclusionCount(inst, addsPeriod, addsMode),
          },
          { period: addsPeriod, mode: addsMode, periods: addsPeriods, buildId: build.buildId },
        );

  /* The type chips. `Notable` is EDITORIAL and orthogonal — it renders
     beside the type chips but is not one of them, so selecting a type never
     hides a notable manager of that type. */
  const chipsHtml =
    `<div class="mgr-chips" id="mgr-chips" role="group" aria-label="Filter managers">` +
    `<button type="button" class="mgr-chip mgr-chip-notable" data-mgr-notable="1" aria-pressed="false">notable</button>` +
    (Object.keys(MANAGER_TYPE_LABELS) as ManagerType[])
      .map(
        (t) =>
          `<button type="button" class="mgr-chip" data-mgr-type="${esc(t)}" aria-pressed="${DEFAULT_TYPES.has(t)}">${esc(
            MANAGER_TYPE_LABELS[t],
          )}</button>`,
      )
      .join("") +
    `</div>` +
    /* The curated-coverage caveat moves onto the Type column it is
       about, carrying its `N of M` count with it — see `typeNote` below, which
       is what `headNotes` renders. The `<noscript>` stays visible here, because
       it is about scripting rather than about a column and no column note is
       the right home for it. */
    /* launch M7b: true of the rows a reader without JavaScript gets — the
       server's default view (the pressed chip, by value), not every manager */
    `<p class="caveat-line"><noscript>Filtering by chip needs JavaScript; the rows below are the default view.</noscript></p>`;
  /* The page's figures are bound to ONE closed quarter — the newest whose
     45-day filing window has passed — never each filer's latest period folded
     into a falsely uniform total. The period comes from the concentration
     table (a row per filer-period), not the adds leaderboard's list, which is
     empty on an aggregate without the optional adds table. The Signals
     Institutional tab reads the same quarter (`getSignalsInstitutional`). */
  const analyticsPeriod = closedPeriods(concentrationPeriods(inst), asOf)[0] ?? null;
  const tracked = analyticsPeriod === null ? null : trackedValueFor(inst, analyticsPeriod);
  /* signals-v4 LD18: the lede and the method foot are the "About this page"
     tip; the methodology link stays visible in the page foot */
  const aboutTip = note(
    "What tracked 13F filers reported each quarter, and what changed between quarters. " +
      "Quarter-end positions, disclosed up to 45 days later; never current holdings, never a complete portfolio. " +
      "Changes are classified from comparable reported positions; a missing position is not proof of a sale.",
    { scope: "inst-head" },
    "about",
    { trigger: "mark", name: "About this page" },
  );
  /* LD18: the provenance chips — the closed quarter, the newest filing (amber)
     and, while a quarter's filing window is open, its deadline (amber). The
     freshness line, the open-window banner's sentence and the snapshot caveat
     are the chips' one tip. */
  const provTip = noteFromHtml(
    `<span class="si-tip-p">13F universe · quarterly, 45-day lag · long positions only · never current holdings: quarter-end positions, filed up to 45 days after the quarter.${tracked ? ` ${fmtInt(tracked.filers)} filers reported for ${esc(tracked.period)}.` : ""}</span>` +
      `<span class="si-tip-p">${esc(instFreshnessText(inst.watermarks.latest_filed_date ?? null, inst.watermarks.latest_period_of_report ?? null, asOf))}</span>` +
      (window?.open ? `<span class="si-tip-p">${s7CopyHtml(window)}</span>` : "") +
      `<span class="si-tip-p"><a href="#inst-data-note">What a 13F covers §</a></span>`,
    { scope: "inst-prov" },
    "about",
    { trigger: "mark", name: "About this 13F data" },
  );
  bodyHtml =
    `<header class="entity-head"><div class="entity-head-copy">` +
    /* launch M7b (inst-01): the kicker repeated the nav and the H1 */
    `<div class="page-title-row"><h1 class="entity-title">Institutional</h1>${aboutTip}</div>` +
    `<p class="entity-lede">Every 13F filer, and what each changed.</p>` +
    `</div>` + disclosureLedger([
      { label: "Filers tracked", value: fmtInt(inst.filers.length), detail: tracked ? `${fmtInt(tracked.filers)} filed ${tracked.period}` : "published registry", subKind: tracked ? "count" : "plain" },
      { label: "Tracked value", value: tracked ? fmtUsd(tracked.totalValueUsd) : "—", detail: tracked ? `13F long only · ${tracked.period}${tracked.partialBooks > 0 ? ` · ≥ (${fmtInt(tracked.partialBooks)} partial books)` : ""}` : "no closed quarter yet", subKind: tracked ? "qualifier" : "absence" },
      { label: "Notable managers", value: fmtInt(notableCiks.size), detail: "curated registry", subKind: "plain" },
    ], { scope: "inst-ledger" }) + `</header>` +
    /* R4: ONE source for the quarter — the CLOSED analytics period; the
       manifest watermark (the newest filing received) is its own chip. */
    `<div class="design-provenance inst-prov">` +
    `<span class="sig-pchip">Closed quarter ${esc(analyticsPeriod ?? "unavailable")}</span>` +
    `<span class="sig-pchip sig-pchip-warn">${inst.watermarks.latest_filed_date ? `Filings through ${esc(inst.watermarks.latest_filed_date)}` : "Newest filing date not available"}</span>` +
    (window?.open ? `<span class="sig-pchip sig-pchip-warn">${esc(quarterLabel(window.quarterEnd) ?? window.quarterEnd)} window open → ${esc(window.deadline)}</span>` : "") +
    provTip +
    `</div>` +
    /* LD18: the one-line pointer to where the moved sections live now
       (launch M7b, inst-02: one short line) */
    `<p class="inst-moved">Moves and Consensus are on <a href="/signals/#institutional">Signals →</a></p>` +
    `<section class="panel panel-wide" id="inst-managers-section" aria-label="Manager directory">` +
    `<div class="panel-head"><h2 class="section-h">Filer directory</h2>` +
    `<span class="panel-note"><input class="filter-select filter-text" type="search" id="inst-index-q" ` +
    `placeholder="filer name or CIK" aria-label="search filers by name or CIK — on this device" /></span></div>` +
    chipsHtml +
    /* LD19: the count stays visible; how to read and re-sort it is its tip */
    /* The count is the note the client writes after every render, from the same
       call that drew these rows: the server's table is already filtered to the
       default chip, so a bare filer total above it contradicted the list. */
    `<p class="section-note"><span id="inst-index-count">${esc(directory.note)}</span> ` +
    note(
      /* true of the reference rows (M3-D): the quarter is in the value's note */
      "Each value is the filer's latest period, named in the value's note. Choose a column header to re-sort.",
      { scope: "inst-index" },
      "about",
      { trigger: "mark", name: "About the directory" },
    ) +
    `<noscript> · sorting and search need JavaScript; the default order below is by value, largest first</noscript></p>` +
    /* Launch M7b (R32, LD28): the VISIBLE load and failure line. The rows
       arrive on the first search, chip or sort; while they load this says so,
       and if they cannot be fetched it says what still holds — the rows above
       are the server's, unchanged and correct. Hidden only while it has
       nothing to say. */
    `<p class="caveat-line inst-index-load" id="inst-index-load" role="status" aria-live="polite" hidden></p>` +
    `<div class="table-scroll"><table class="etable" data-sticky-first${dataColumnsAttr(dirCols)}>` +
    `<caption class="visually-hidden">13F filers ranked by reported 13(f) long value for each filer's latest period</caption>` +
    `<thead><tr>${heads}</tr></thead>` +
    `<tbody id="inst-managers-tbody">${rows}</tbody></table></div>` +
    /* The named bound is stated by the control itself, VISIBLE
       from the server. Nothing reveals this control at load — the directory's
       `syncDisclosure` runs only from a render — so a bound that lived on the
       button was stated to nobody until the reader sorted or filtered.

       The bound's remainder (each filer's own page) is state-independent:
       true collapsed and expanded alike, so it survives an expansion that
       retracts the count (launch M7b, inst-03: shortened, the fact kept). */
    compactDisclosure({
      rootId: "inst-managers-tbody",
      total: directory.total,
      shown: directory.shown,
      noun: "managers",
      bound: `Every filer has its own page.`,
    }) +
    `<p class="visually-hidden" id="inst-index-status" role="status" aria-live="polite"></p>` +
    `<script type="application/json" id="inst-index-shards">${serializeInlineJson(JSON.parse(directoryFamily.listJson))}</script>` +
    `</section>` +
    /* Recent activity, full width — never inside a pair. */
    `<div class="design-activity">` +
    activitySectionHtml(feed, { reference: true, tierOf: (cik) => filerTier(build, cik), notableCiks: notableCiks }) + `</div>` +
    `<details class="design-supplement"><summary>Recently added issuers · explore published changes</summary>` + addsHtml + `</details>` +
    `<p class="si-foot" id="inst-method-foot"><a href="/methodology/#13f-method">How 13F data is read ↗</a></p>`;
}
const description = build.inst.present
  ? "Institutional 13F module: filers, holders, quarter-over-quarter moves from the published Public Filings aggregate."
  : "The institutional 13F module is not in this build — absence is stated, not simulated.";
---

<Base
  title="Institutional 13F — Public Filings"
  description={description}
  active="institutional"
  footer="inst13f"
>
  <main class="shell page design-page" id="institutional-page">
    <Fragment set:html={bodyHtml} />
  </main>

  <script>
    import {
      initInstIndex,
      initAddsControls,
      initDomDisclosures,
    } from "../../scripts/inst-index-client";
    import { initNotes } from "../../scripts/notes";
    initInstIndex();
    initAddsControls();
    initDomDisclosures();
    /* One `initNotes()` per surface that passes a note scope. Binding
       is DELEGATED on `document`, so one call covers notes created later by an
       `innerHTML` replacement — a sort repaint, a page change, a period switch —
       and a second call would be idempotent. It is NOT added to `Base.astro`:
       that would load the module on every page in the site, including the ones
       this run does not touch, for no benefit. Without it a note still OPENS,
       through `popovertarget` alone; what this adds is placement, hover, Escape
       and outside-click. */
    initNotes();
  </script>
</Base>
