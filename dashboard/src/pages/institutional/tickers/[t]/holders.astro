---
// 13F holders deep view (Ticker Holders.dc.html), bound to
// agg_issuer_top_holders via the ticker→issuer mapping contract: static
// paths exist ONLY for tickers that resolve through the mapping AND whose
// issuer is entity-keyed in the aggregate — i.e. as-of-resolved identity, the
// same standard the full holder list below is served under.
//
// Two sections, deliberately not merged: the ranked top-N slice from
// agg_issuer_top_holders (unchanged), then <HoldingsTable>, which serves the
// as-of-resolved holder list from the M2-8 issuer projection with the
// unresolved row count, unresolved value and identity coverage BESIDE it. That
// projection carries per-row filed dates, lags and document links, so those
// columns are no longer dropped there — the caveat on the aggregate table
// still applies to the aggregate table.
import Base from "../../../../layouts/Base.astro";
import HoldingsTable from "../../../../components/HoldingsTable.astro";
import { getBuildData, filerTier } from "../../../../lib/data";
import { holdersFor, issuerPeriods } from "../../../../lib/inst";
import { holdersBody } from "../../../../lib/ui";
import { filingWindow, resolveTicker } from "../../../../lib/derive";
import { serializeInlineJson } from "../../../../lib/inline-json";

export function getStaticPaths() {
  const build = getBuildData();
  if (!build.inst.present) return [];
  const paths: { params: { t: string }; props: { issuerKey: string; name: string } }[] = [];
  for (const t of build.tickers) {
    const res = resolveTicker(build.tickerMap, t.ticker);
    if (res.state !== "resolved") continue;
    const rows = build.inst.holdersByIssuer.get(res.issuerKey) ?? [];
    if (!rows.some((r) => r.issuer_key_source === "entity")) continue;
    paths.push({ params: { t: t.ticker }, props: { issuerKey: res.issuerKey, name: res.name } });
  }
  return paths;
}

const { t } = Astro.params;
const { issuerKey, name } = Astro.props as { issuerKey: string; name: string };
const build = getBuildData();
const inst = build.inst;
if (!inst.present) throw new Error("holders page built without the inst module");
const periods = issuerPeriods(inst, issuerKey);
const period = periods.at(-1)!;
// The top/tail budget state rides on every holder row — through the SSR
// body AND the embedded period payload below — so the client period switch
// re-renders the same filerHref targets the SSR produced.
const holders = (inst.holdersByIssuer.get(issuerKey) ?? [])
  .filter((h) => h.issuer_key_source === "entity")
  .map((h) => ({ ...h, tier: filerTier(build, h.cik) }));
const window = filingWindow(build.generatedAtDate);

const bodyHtml = holdersBody(
  t!,
  name,
  holders,
  periods,
  period,
  inst.watermarks.latest_filed_date,
  inst.topn,
  window,
);

const periodData = serializeInlineJson({
  latestFiled: inst.watermarks.latest_filed_date,
  topn: inst.topn,
  periods: Object.fromEntries(
    periods.map((p) => [
      p,
      holdersFor(inst, issuerKey, p)
        .filter((h) => h.issuer_key_source === "entity")
        .map((h) => ({ ...h, tier: filerTier(build, h.cik) })),
    ]),
  ),
});
const description =
  `Institutional holders of ${t} per 13F filings — the as-of-resolved holder list with the ` +
  `unresolved remainder counted beside it; quarter-end snapshots, never current holdings.`;
---

<Base
  title={`Who holds ${t} — 13F — Public Filings`}
  description={description}
  active="institutional"
  footer="inst13f"
>
  <main class="shell page entity-page">
    <Fragment set:html={bodyHtml} />
    <HoldingsTable
      kind="holders"
      issuerKey={issuerKey}
      issuerName={name}
      ticker={t!}
      period={period}
    />
    <script is:inline type="application/json" id="holders-period-data" set:html={periodData} />
  </main>
  <script>
    import { initHoldersPeriods } from "../../../../scripts/entity-client";
    import { initNotes } from "../../../../scripts/notes";
    initHoldersPeriods();
    /* One `initNotes()` per surface that passes a note scope. Binding
       is DELEGATED on `document`, so one call covers notes created later by an
       `innerHTML` replacement — a sort repaint, a page change, a period switch —
       and a second call would be idempotent. It is NOT added to `Base.astro`:
       that would load the module on every page in the site, including the ones
       this run does not touch, for no benefit. Without it a note still OPENS,
       through `popovertarget` alone; what this adds is placement, hover, Escape
       and outside-click. */
    initNotes();
  </script>
</Base>
