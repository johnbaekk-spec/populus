---
// Institutional Filer page — the ENTITY archetype of
// docs/frontend/design-principles.md §7, bound to the
// published aggregates with period-correct sourcing: identity from
// agg_filer_registry; every period-scoped tile from agg_filer_concentration;
// changes from agg_qoq_deltas. The filer's COMPLETE reported position list —
// the selected quarter and the one before it (OD-5) — is served below the
// aggregate by <HoldingsTable>: M2-CONTRACT §3 was amended 2026-08-02 and the
// EDGAR link is now provenance for those rows, not a substitute for them.
// Route param is the UNPADDED CIK (/institutional/filers/1067983/).
import Base from "../../../layouts/Base.astro";
import HoldingsTable from "../../../components/HoldingsTable.astro";
import { filerAggregateInputs, filerDefaultPeriod, getBuildData, servedPeriods, topFilerCiks } from "../../../lib/data";
import { filerPeriods } from "../../../lib/inst";
import { filerBody } from "../../../lib/ui/index.ts";
import { filingWindow } from "../../../lib/derive";
import { serializeInlineJson } from "../../../lib/inline-json";
import { concentrationBenchmark } from "../../../lib/inst-analytics";

export function getStaticPaths() {
  // Pre-render ONLY the top 1,500 by descending
  // latest-period reported total value, ties ascending CIK — the same exported
  // selection (`selectTopFilers` via `topFilerCiks`) every link producer uses,
  // so the pages that exist and the links that point at them cannot disagree.
  // Every other published filer is addressable through /e/ via the routing
  // index + shard family, never a 404.
  const build = getBuildData();
  if (!build.inst.present) return [];
  const tops = topFilerCiks(build);
  return build.inst.filers
    .filter((f) => tops.has(f.cik))
    .map((f) => ({
      params: { cik: String(Number(f.cik)) },
      props: { cik10: f.cik },
    }));
}

const { cik10 } = Astro.props as { cik10: string };
const build = getBuildData();
const inst = build.inst;
if (!inst.present) throw new Error("filer page built without the inst module");
const filer = inst.filers.find((f) => f.cik === cik10)!;
/* R4 / LD3 §5: the period selector lists exactly the periods the serving
   projection carries rows for (four for a notable filer, two otherwise) — a
   button for a quarter with nothing to browse was the "empty period button"
   defect. When no serving artifact is reachable the aggregate periods stand. */
const served = servedPeriods(build, cik10);
const aggPeriods = filerPeriods(inst, cik10);
const periods = served && served.length > 0 ? aggPeriods.filter((p) => served.includes(p)) : aggPeriods;
// R4/T4: the landing's closed-quarter rule picks the default, not the newest period.
const period = filerDefaultPeriod(build, periods) ?? filer.latest_period;
// R6: the producer's book-discontinuity flag per period (kept, bannered).
const discontinuityFor = (p: string): boolean => agg.discontinuityPeriods.includes(p);
const window = filingWindow(build.generatedAtDate);
const latestFiled = inst.watermarks.latest_filed_date;

/* This page used to rebuild the aggregate payload inline — a second
   implementation of `filerAggregateInputs`, which the shard path already used.
   Two producers of one payload is how the pre-rendered page and a shard-served
   tail filer drift; it is also why a bound applied to one would have missed the
   other. There is now ONE producer, and it is the one that applies the bound. */
const agg = filerAggregateInputs(build, cik10);
const conc = agg.concByPeriod[period] ?? null;
const deltas = agg.deltasByPeriod[period] ?? [];
const deltaTotal = agg.deltaTotalsByPeriod[period] ?? 0;
// The tracked-population medians the book-shape band compares against, per
// period, computed once here and embedded for the period switch.
const benchmarks = Object.fromEntries(periods.map((p) => [p, concentrationBenchmark(inst, p)]));
/* R15: the new-stake and exit counts are over the WHOLE period's changes
   (`deltasFor`), never the embedded, byte-bounded slice. */
const kindsFor = (p: string): { new: number; exit: number } | null => agg.kindsByPeriod[p] ?? null;
// One producer (filerAggregateInputs) for both routes — the tail payload carries the same.
const typing = agg.typing;

const bodyHtml = filerBody(
  { cik: cik10, name: filer.filer_name, latestPeriod: filer.latest_period },
  periods,
  period,
  conc,
  deltas,
  latestFiled,
  inst.topn,
  window,
  { total: deltaTotal, benchmark: benchmarks[period] ?? null, discontinuity: discontinuityFor(period), kinds: kindsFor(period), typing },
);

// Every period's data, embedded for the client-side period selector: the switch
// re-renders through the SAME filerPeriodSectionHtml the SSR used. `total` rides
// along per period so a client-rendered period states its bound exactly as the
// server-rendered one does.
const periodData = serializeInlineJson({
  latestFiled,
  topn: inst.topn,
  benchmarks,
  periods: Object.fromEntries(
    periods.map((p) => [
      p,
      {
        conc: agg.concByPeriod[p] ?? null,
        deltas: agg.deltasByPeriod[p] ?? [],
        total: agg.deltaTotalsByPeriod[p] ?? 0,
        discontinuity: discontinuityFor(p),
        kinds: kindsFor(p),
      },
    ]),
  ),
});
const description =
  `${filer.filer_name}: every position reported on its 13F for the selected quarter and the ` +
  `one before it, plus per-quarter concentration and position changes classified from the filings.`;
---

<Base
  title={`${filer.filer_name} — 13F filer — Public Filings`}
  description={description}
  active="institutional"
  footer="inst13f"
>
  <main class="shell page entity-page">
    <Fragment set:html={bodyHtml} />
    <HoldingsTable kind="filer" cik={cik10} filerName={filer.filer_name} period={period} />
    <script is:inline type="application/json" id="filer-period-data" set:html={periodData} />
  </main>
  <script>
    import { initFilerPeriods } from "../../../scripts/entity-client";
    import { initDomDisclosures } from "../../../scripts/inst-index-client";
    import { initNotes } from "../../../scripts/notes";
    initFilerPeriods();
    /* R15: the changes table's "Show more" is a DOM-backed disclosure; it is
       re-bound after every period re-render through the `populus:rerender`
       event the period switch dispatches. */
    initDomDisclosures();
    /* One `initNotes()` per surface that passes a note scope. Binding
       is DELEGATED on `document`, so one call covers notes created later by an
       `innerHTML` replacement — a sort repaint, a page change, a period switch —
       and a second call would be idempotent. It is NOT added to `Base.astro`:
       that would load the module on every page in the site, including the ones
       this run does not touch, for no benefit. Without it a note still OPENS,
       through `popovertarget` alone; what this adds is placement, hover, Escape
       and outside-click. */
    initNotes();
  </script>
</Base>
