---
// Home (R18): one masthead claim (≤12 words) + search, three LIVE tiles —
// latest Congress disclosures, notable-manager moves this quarter (R14 data),
// top signals (ticker first) — then the module nav cards. The explainer card
// and the philosophy paragraph are relocated, not cut: one sentence stays
// here, the rest lives at /methodology/#principles, and the range caveat rides
// as a ⓘ on the first amount.
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { getBuildData, moduleAvailability, coverageSummary, getSignalArtifact, notableMovesFor, notableMovesPeriods, filerTier } from "../lib/data";
import { fmtInt, type RenderCtx } from "../lib/format";
import { moduleCard, congressTileHtml, movesTileHtml, signalsTileHtml, sortHits, signalKindShort, HOME_CLAIM } from "../lib/ui/index.ts";
import { filerHref } from "../lib/holdings";

const build = getBuildData();
const avail = moduleAvailability(build);
const cov = coverageSummary(build.stats);
const ssrCtx: RenderCtx = { watched: new Set(), cutMembers: build.cutMembers, cutTickers: build.cutTickers };

const congressTile = congressTileHtml(build.txns, ssrCtx);
const period = notableMovesPeriods(build)[0] ?? null;
const moves = period === null ? [] : notableMovesFor(build, period);
const movesTile = movesTileHtml(moves, period, (cik) => filerHref(cik, filerTier(build, cik)));
const artifact = getSignalArtifact();
const active = sortHits(artifact.signals.filter((s) => s.status === "active"));
const signalsTile = signalsTileHtml(active, ssrCtx, signalKindShort);

const congressCard = moduleCard(
  "Congress",
  "/congress/",
  "House + Senate periodic transaction reports. Ranges, dual dates, receipts.",
  {
    live: avail.congress,
    statLines: [
      `${fmtInt(build.txnCount)} rows · updated ${build.generatedAtDate}`,
      `${cov.housePct}% House e-file parse · ${cov.senatePct}% Senate`,
    ],
  },
);
const instStats = build.inst.present
  ? {
      live: true,
      statLines: [
        `${fmtInt(build.inst.filers.length)} filers on record`,
        `latest closed quarter ${period ?? "—"}`,
      ],
    }
  : {
      live: false,
      statLines: ["not in this build — absence is stated, not simulated"],
    };
const instCard = moduleCard(
  "Institutional",
  "/institutional/",
  "13F holdings: filers, who holds a ticker, quarter-over-quarter moves, concentration.",
  instStats,
);
const signalsCard = moduleCard(
  "Signals",
  "/signals/",
  "Rule-based, receipted, no price data: unusual for the filer, novel for the record, or late.",
  { live: true, statLines: [`${fmtInt(active.length)} hits · window ${artifact.coverageFrom} → ${artifact.coverageTo}`] },
);
const finCard = moduleCard(
  "Financials",
  null,
  "As-reported company financials from EDGAR XBRL, curated universe, vintage-aware.",
  { live: false, statLines: ["gates published before data"] },
);
const macroCard = moduleCard(
  "Macro",
  null,
  "Curve, inflation, labor, positioning — revision-aware series with vintage semantics.",
  { live: false, statLines: ["gates published before data"] },
);

const description =
  "Who's trading, from the filings themselves: congressional trades and institutional holdings from " +
  "primary government sources, republished with their receipts — free, verifiable, honest about its gaps.";
---

<Base title="Public Filings — who's trading, from the filings" description={description} active="home" searchEmphasis={true}>
  <main>
    <div class="hero-band">
      <div class="shell hero hero-claim">
        <div class="hero-copy">
          <div class="hero-kicker">
            <Mark class="hero-mark" />
            <span class="hero-kicker-text">The open financial-data commons</span>
          </div>
          <h1 class="hero-title" id="home-claim">{HOME_CLAIM}</h1>
          <p class="hero-lede">
            Congressional trades and 13F holdings from primary government sources, with their receipts — free, and honest about its gaps.
            <a href="/methodology/#principles">Principles ↗</a>
          </p>
          <div class="hero-ctas">
            <a class="cta cta-primary" href="#site-search">Search members, tickers, managers ⌕</a>
            <a class="cta-plain" href="/methodology/">Methodology ↗</a>
          </div>
        </div>
      </div>
    </div>

    <div class="shell page">
      <div class="home-tiles" id="home-tiles">
        <Fragment set:html={congressTile} />
        <Fragment set:html={movesTile} />
        <Fragment set:html={signalsTile} />
      </div>

      <div class="modules-head">
        <h2 class="section-h2">Modules</h2>
        <div class="mono-note">freshness and coverage regenerate from stats.json on every build</div>
      </div>
      <div class="mod-grid">
        <Fragment set:html={congressCard} />
        <Fragment set:html={instCard} />
        <Fragment set:html={signalsCard} />
        <Fragment set:html={finCard} />
        <Fragment set:html={macroCard} />
      </div>
    </div>
  </main>

  <script>
    import { initWatchStars } from "../scripts/entity-client";
    import { initNotes } from "../scripts/notes";
    initWatchStars();
    initNotes();
  </script>
</Base>
