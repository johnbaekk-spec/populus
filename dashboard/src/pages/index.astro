---
// Home A, "Signals first" (launch M2; owner decision D1; R14–R17, LD14–LD17):
// the hero — the claim, a launcher into the ONE masthead search, and "Try"
// chips ranked from the build — beside the four-figure ledger; then "What
// stands out" (the triage's three lead cards, each opening its row on
// /signals/), "Latest from Congress" and "Notable managers" side by side, and
// the trust strip. The Modules grid is gone, and there is no sign-up band
// (D2). Every figure and name is computed from the build here and rendered by
// lib/ui/home.ts; the philosophy stays one link away at
// /methodology/#principles.
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { getBuildData, coverageSummary, getSignalArtifact, getTriage, notableMovesFor, notableMovesPeriods, filerTier } from "../lib/data";
import { closedPeriods, corpusAsOf } from "../lib/inst-adds";
import { concentrationPeriods } from "../lib/inst-analytics";
import { searchIndexValid } from "../lib/derive";
import { type RenderCtx } from "../lib/format";
import {
  HOME_KICKER,
  homeTryChips,
  largestNotableFiler,
  homeHeroCopyHtml,
  homeFigures,
  homeLedgerHtml,
  homeLeadHtml,
  congressTileHtml,
  movesTileHtml,
  homeTrustHtml,
  homeSectionsHtml,
} from "../lib/ui/index.ts";
import { filerHref } from "../lib/holdings";

const build = getBuildData();
const ctx: RenderCtx = { cutMembers: build.cutMembers, cutTickers: build.cutTickers };
const cov = coverageSummary(build.stats);
const artifact = getSignalArtifact();
const triage = getTriage();
const active = artifact.signals.filter((s) => s.status === "active");

/* 13F: the newest quarter closed for filing (judged against the corpus, R4)
   for the ledger and the "Try" filer; the quarter the moves band offers for
   "Notable managers" (the newest closed quarter that carries moves). */
const inst = build.inst;
const closedQuarter = inst.present
  ? (closedPeriods(concentrationPeriods(inst), corpusAsOf(build.generatedAtDate, inst.watermarks.latest_filed_date), 1)[0] ?? null)
  : null;
const filingsThrough = inst.present ? inst.watermarks.latest_filed_date : null;
const period = notableMovesPeriods(build)[0] ?? null;
const moves = period === null ? [] : notableMovesFor(build, period);

/* LD17: the chips rank the search index the masthead search ships */
const parsedIndex: unknown = JSON.parse(build.searchIndexJson);
const searchIndex = searchIndexValid(parsedIndex) ? parsedIndex : null;
const filer = largestNotableFiler(inst, closedQuarter);
const chips = homeTryChips(searchIndex, filer ? { name: filer.name, href: filerHref(filer.cik, filerTier(build, filer.cik)) } : null, ctx);

const figures = homeFigures({
  txns: build.txns,
  paper: build.paper,
  members: build.members,
  filedFrom: build.filedFrom,
  stats: build.stats,
  coverage: cov,
  inst: inst.present ? { present: true, filers: inst.filers.length, closedQuarter, filingsThrough } : { present: false },
  signals: { active: active.length, retentionDays: artifact.retentionDays, coverageFrom: artifact.coverageFrom, coverageTo: artifact.coverageTo },
  triage: { stands: triage.counts.stands, ranked: triage.rows.length },
  generatedAtDate: build.generatedAtDate,
});

const heroCopy = homeHeroCopyHtml(chips);
const ledger = homeLedgerHtml(figures);
const sections = homeSectionsHtml({
  lead: homeLeadHtml(triage, ctx, artifact.retentionDays),
  congress: congressTileHtml(build.txns, ctx),
  moves: movesTileHtml(moves, period, (cik) => filerHref(cik, filerTier(build, cik)), { filingsThrough, instPresent: inst.present }),
  trust: homeTrustHtml(build.stats),
});

const description =
  "Who's trading, from the filings themselves: congressional trades and institutional holdings from " +
  "primary government sources, republished with their receipts — free, verifiable, honest about its gaps.";
---

<Base title="Public Filings — who's trading, from the filings" description={description} active="home" searchEmphasis={true}>
  <main>
    <section class="hero-band" aria-labelledby="home-claim">
      <div class="shell hero">
        <div class="home-hero-copy">
          <div class="hero-kicker">
            <Mark class="hero-mark" />
            <span class="hero-kicker-text">{HOME_KICKER}</span>
          </div>
          <Fragment set:html={heroCopy} />
        </div>
        <Fragment set:html={ledger} />
      </div>
    </section>

    <div class="shell page home-page">
      <Fragment set:html={sections} />
    </div>
  </main>

  <script>
    import { initNotes } from "../scripts/notes";
    initNotes();
  </script>
</Base>
