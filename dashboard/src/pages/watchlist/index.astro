---
// A-3 (ALPHA-UX): /watchlist — the read surface for the watch-v2 store. The
// store is device-local, so the page is a client island over the published
// dataset; the server ships only the shell and the build's coverage facts
// the D-1c cursor rule needs (earliest retained filed date).
import Base from "../../layouts/Base.astro";
import { getBuildData } from "../../lib/data";
import { feedHeadHtml } from "../../lib/format";
import { earliestRetainedFiled } from "../../lib/watchlist";

const build = getBuildData();
// The exact earliest retained FILED date across BOTH families (txns AND
// paper) — the D-1c coverage-gap boundary. Year-granular `filedFrom`
// would misclassify a cursor inside the earliest year.
const earliestFiled = earliestRetainedFiled(build.txns, build.paper, build.generatedAtDate);
const description =
  "Your watched members and tickers, their latest filings, and what is new since you last " +
  "looked — stored in this browser only; no account, no cross-site tracking.";
---

<Base title="Watchlist — Public Filings" description={description} active="congress">
  <main
    class="shell page"
    id="watchlist-root"
    data-build-id={build.buildId}
    data-filed-from={earliestFiled}
  >
    <div class="page-head">
      <div class="page-head-copy">
        <div class="kicker">/watchlist</div>
        <h1 class="page-title">Watchlist</h1>
        <p class="page-lede">
          Watched members and tickers, with their filings from this build. The
          watchlist and the last-seen marker live in this browser only — no
          account, nothing leaves your device. Star a member on
          <a href="/congress/">the feed</a> or a ticker on its page to add it here.
        </p>
      </div>
    </div>

    <div id="watch-banner"></div>

    <div class="watch-controls">
      <div class="chips" id="watch-chips"></div>
      <label class="filter-check" for="watch-new-only">
        <input type="checkbox" id="watch-new-only" />
        only new since last look
      </label>
      <button class="pager-btn" id="watch-mark-seen">mark all seen</button>
    </div>

    <div class="feed-empty" id="watch-empty" hidden>
      <h2>Nothing watched yet — and that's a state, not an error.</h2>
      <p>
        Watch stars save to this browser. Star a member on
        <a href="/congress/">the congressional feed</a> or a ticker on its page,
        then return here.
      </p>
    </div>

    <div class="feed">
      <!-- The watched rows render through the SAME `feedItemHtml` the congress
           feed uses, and that renderer emits real table rows now, so
           this list is a table too. Two renderers would be two sets of honesty
           rules to keep in step. -->
      <table class="feed-table">
        <caption class="visually-hidden">Filings for the members and tickers watched on this device</caption>
        <!-- This table had a body and no header row at all. It renders the
             same nine cells as the congress feed, through the same
             `feedItemHtml`, so every one of them was reaching a screen reader
             with no column to belong to. It uses the feed's own column
             contract, in its unsortable rendering: this view has no sort
             control, so the two orderable columns state that rather than
             carrying a dead button. The header folds by clipping at narrow
             widths like the feed's, which keeps it in the accessibility tree at
             every width. -->
        <Fragment
          set:html={feedHeadHtml({
            sortable: false,
            whyUnsorted:
              "the watchlist is a device-local view listed newest filed first and offers no " +
              "sort control — the congressional feed sorts the full published set by this column",
          })}
        />
        <tbody id="watch-body"></tbody>
      </table>
      <div class="filter-count"><span id="watch-count"></span></div>
    </div>

    <noscript>
      <p class="section-note">
        The watchlist is stored in your browser and needs JavaScript to read
        back. The full published dataset is at
        <a href="/congress/data/feed.v1.json">feed.v1.json</a>.
      </p>
    </noscript>
  </main>

  <script>
    import { initWatchlist } from "../../scripts/watchlist-client";
    initWatchlist();
  </script>
</Base>
