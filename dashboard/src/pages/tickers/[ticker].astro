---
import { pathSafeTicker } from "../../lib/format.ts";
// Unified ticker page — the primary ticker surface and the INSTRUMENT
// archetype of docs/frontend/design-principles.md §7: the five-figure head,
// the "On Signals" block, then two tabs — Congress and the mapping-gated
// Institutional section (gated on the ticker→issuer mapping contract, spec §4).
import Base from "../../layouts/Base.astro";
import { getBuildData, tickerInstSection, getTriage, notableMovesPeriods, filerTier } from "../../lib/data";
import { overlapBand, tickerOverlapHtml } from "../../lib/overlap";
import { filerHref } from "../../lib/holdings";
import { resolveTicker } from "../../lib/derive";
import { tickerCrowding } from "../../lib/inst-analytics";
import { tickerUnifiedBody, type BuildStamps, type TickerPageDeps } from "../../lib/ui/index.ts";
import type { RenderCtx } from "../../lib/format";

export function getStaticPaths() {
  const build = getBuildData();
  return build.tickers
    .filter((t) => !build.cutTickers.has(t.ticker))
    // TD-6, dashboard side: a ticker that cannot round-trip as a route param
    // (the Senate corpus contains one with a literal newline) gets no page;
    // links route it to the /e/ fallback instead (tickerHrefFor).
    .filter((t) => pathSafeTicker(t.ticker))
    .map((t) => ({ params: { ticker: t.ticker } }));
}

const { ticker } = Astro.params;
const build = getBuildData();
const entity = build.tickersByKey.get(ticker!)!;
const inst = tickerInstSection(build, entity.ticker);
const stamps: BuildStamps = {
  buildId: build.buildId,
  generatedAt: build.generatedAt,
  generatedAtDate: build.generatedAtDate,
};
const ssrCtx: RenderCtx = {
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
// Ticker.dc.html bands that need the corpus: the build's Signals triage (the
// "On Signals" block and the rows it pins, signals-v3 M3), crowding among
// ranked issuers (only when the ticker resolves), committee roster when the
// build carries it. The /e/ route passes none of these.
const resolved = resolveTicker(build.tickerMap, entity.ticker);
const crowding =
  resolved.state === "resolved" && inst.state === "data" && inst.period
    ? tickerCrowding(build.inst, resolved.issuerKey, inst.period)
    : null;
/* R19: the Congress ↔ notable-managers overlap band — the Congress half from
   this ticker's own rows (last 90 days by filed date), the 13F half from the
   class-grain holders of the closed quarter, or — when that side cannot be
   read — a plain statement of the absence and its reason (signals-v3 M3
   success criterion 4: a ticker page renders no PLANNED markup). */
const hrefOf = (cik: string): string => filerHref(cik, filerTier(build, cik));
const overlapHtml = tickerOverlapHtml(
  overlapBand({
    ticker: entity.ticker,
    txns: entity.txns,
    generatedAtDate: build.generatedAtDate,
    inst: build.inst,
    typingByCik: build.inst.present ? build.inst.typingByCik : new Map(),
    period: notableMovesPeriods(build)[0] ?? null,
    ctx: ssrCtx,
    filerHref: hrefOf,
  }),
  ssrCtx,
  hrefOf,
);
const deps: TickerPageDeps = {
  overlap: overlapHtml,
  triage: getTriage(),
  crowding,
  committees: build.committeeData
    ? { byMember: build.committeeData.byMember, windowFrom: build.committeeData.windowFrom, windowTo: build.committeeData.windowTo, snapshotDate: build.committeeData.snapshotDate }
    : null,
};
const bodyHtml = tickerUnifiedBody(entity, inst, stamps, ssrCtx, { fullTable: false }, deps);
const description =
  `${entity.ticker}: every public disclosure record Public Filings holds — congressional trades ` +
  `on the 45-day PTR clock and 13F quarter-end holdings, each with its own clock stated.`;
---

<Base
  title={`${entity.ticker} — disclosures — Public Filings`}
  description={description}
  searchEmphasis={true}
>
  <main class="shell page entity-page" data-entity-kind="t" data-entity-key={entity.ticker}>
    <Fragment set:html={bodyHtml} />
  </main>
  <script>
    import { initEntityPage } from "../../scripts/entity-client";
    import { initTabs } from "../../scripts/tabs";
    import { initNotes } from "../../scripts/notes";
    import { initHeldRows } from "../../scripts/inst-index-client";
    import { TICKER_HOLDER_HELD } from "../../lib/ui/ticker.ts";
    initEntityPage();
    // signals-v3 M3 (R16): the Congress / Institutional tabs
    initTabs(document);
    // launch M7b (R33): the Institutional tab's holders 26..N
    initHeldRows({ "ticker-holder": TICKER_HOLDER_HELD });
    // launch M1c (R12): tips open as bottom sheets at ≤720px here too
    initNotes();
  </script>
</Base>
