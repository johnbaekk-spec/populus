---
import { pathSafeTicker } from "../../lib/format.ts";
// Unified ticker page (Ticker Unified.dc.html) — the primary ticker surface:
// search-first masthead, congress cards, the mapping-gated institutional
// section (gated on the ticker→issuer mapping contract, spec §4), planned-section placeholders.
import Base from "../../layouts/Base.astro";
import { getBuildData, tickerInstSection } from "../../lib/data";
import { tickerUnifiedBody, type BuildStamps } from "../../lib/ui/index.ts";
import type { RenderCtx } from "../../lib/format";

export function getStaticPaths() {
  const build = getBuildData();
  return build.tickers
    .filter((t) => !build.cutTickers.has(t.ticker))
    // TD-6, dashboard side: a ticker that cannot round-trip as a route param
    // (the Senate corpus contains one with a literal newline) gets no page;
    // links route it to the /e/ fallback instead (tickerHrefFor).
    .filter((t) => pathSafeTicker(t.ticker))
    .map((t) => ({ params: { ticker: t.ticker } }));
}

const { ticker } = Astro.params;
const build = getBuildData();
const entity = build.tickersByKey.get(ticker!)!;
const inst = tickerInstSection(build, entity.ticker);
const stamps: BuildStamps = {
  buildId: build.buildId,
  generatedAt: build.generatedAt,
  generatedAtDate: build.generatedAtDate,
};
const ssrCtx: RenderCtx = {
  watched: new Set(),
  watchedTickers: new Set(),
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
const bodyHtml = tickerUnifiedBody(entity, inst, stamps, ssrCtx, { fullTable: false });
const description =
  `${entity.ticker}: every public disclosure record Public Filings holds — congressional trades ` +
  `on the 45-day PTR clock and 13F quarter-end holdings, each with its own clock stated.`;
---

<Base
  title={`${entity.ticker} — disclosures — Public Filings`}
  description={description}
  searchEmphasis={true}
>
  <main class="shell page entity-page" data-entity-kind="t" data-entity-key={entity.ticker}>
    <Fragment set:html={bodyHtml} />
  </main>
  <script>
    import { initEntityPage } from "../../scripts/entity-client";
    initEntityPage();
  </script>
</Base>
