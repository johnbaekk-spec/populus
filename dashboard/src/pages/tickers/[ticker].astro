---
import { pathSafeTicker } from "../../lib/format.ts";
// Unified ticker page — the primary ticker surface and the INSTRUMENT
// archetype of docs/frontend/design-principles.md §7:
// search-first masthead, congress cards, the mapping-gated institutional
// section (gated on the ticker→issuer mapping contract, spec §4), planned-section placeholders.
import Base from "../../layouts/Base.astro";
import { getBuildData, tickerInstSection, getSignalArtifact } from "../../lib/data";
import { resolveTicker } from "../../lib/derive";
import { tickerCrowding } from "../../lib/inst-analytics";
import { tickerUnifiedBody, type BuildStamps, type TickerPageDeps } from "../../lib/ui/index.ts";
import type { RenderCtx } from "../../lib/format";

export function getStaticPaths() {
  const build = getBuildData();
  return build.tickers
    .filter((t) => !build.cutTickers.has(t.ticker))
    // TD-6, dashboard side: a ticker that cannot round-trip as a route param
    // (the Senate corpus contains one with a literal newline) gets no page;
    // links route it to the /e/ fallback instead (tickerHrefFor).
    .filter((t) => pathSafeTicker(t.ticker))
    .map((t) => ({ params: { ticker: t.ticker } }));
}

const { ticker } = Astro.params;
const build = getBuildData();
const entity = build.tickersByKey.get(ticker!)!;
const inst = tickerInstSection(build, entity.ticker);
const stamps: BuildStamps = {
  buildId: build.buildId,
  generatedAt: build.generatedAt,
  generatedAtDate: build.generatedAtDate,
};
const ssrCtx: RenderCtx = {
  watched: new Set(),
  watchedTickers: new Set(),
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
// Ticker.dc.html bands that need the corpus: signals naming this ticker,
// crowding among ranked issuers (only when the ticker resolves), committee
// roster when the build carries it. The /e/ route passes none of these.
const resolved = resolveTicker(build.tickerMap, entity.ticker);
const crowding =
  resolved.state === "resolved" && inst.state === "data" && inst.period
    ? tickerCrowding(build.inst, resolved.issuerKey, inst.period)
    : null;
const deps: TickerPageDeps = {
  signals: getSignalArtifact().signals.filter((s) => s.status === "active" && s.entities.ticker === entity.ticker),
  crowding,
  committees: build.committeeData
    ? { byMember: build.committeeData.byMember, windowFrom: build.committeeData.windowFrom, windowTo: build.committeeData.windowTo, snapshotDate: build.committeeData.snapshotDate }
    : null,
};
const bodyHtml = tickerUnifiedBody(entity, inst, stamps, ssrCtx, { fullTable: false }, deps);
const description =
  `${entity.ticker}: every public disclosure record Public Filings holds — congressional trades ` +
  `on the 45-day PTR clock and 13F quarter-end holdings, each with its own clock stated.`;
---

<Base
  title={`${entity.ticker} — disclosures — Public Filings`}
  description={description}
  searchEmphasis={true}
>
  <main class="shell page entity-page" data-entity-kind="t" data-entity-key={entity.ticker}>
    <Fragment set:html={bodyHtml} />
  </main>
  <script>
    import { initEntityPage } from "../../scripts/entity-client";
    initEntityPage();
  </script>
</Base>
