---
// Generic entity route: a prerendered page served HTTP 200 whose
// client driver renders long-tail in-extract entities (S4) from their columnar
// endpoints and out-of-extract entities as S2 with a primary-source CTA. The
// shell paints first; the skeleton appears only below it and is never
// indefinite (watchdog + the full failure taxonomy in qoq-presentation.md §3).
import Base from "../../layouts/Base.astro";

const description =
  "Long-tail entity route: the record renders on your device from the same published extract " +
  "the pre-rendered pages use — same-origin, no external calls.";
---

<Base title="Entity — Public Filings" description={description}>
  <main class="shell page entity-page" id="entity-root">
    <noscript>
      <div class="s4-error">
        <h1 class="s1-h">This route renders on your device, and JavaScript is off.</h1>
        <p class="s1-detail">
          The record itself is still published: the data endpoints under <span class="mono-id">/congress/data/</span> serve the same columnar
          extract the pre-rendered pages are built from.
        </p>
        <a class="plain-link" href="/congress/">back to the feed ↗</a>
      </div>
    </noscript>
  </main>
  <script>
    import { runGenericRoute } from "../../scripts/entity-client";
    import { initDomDisclosures, registerHeldRows } from "../../scripts/inst-index-client";
    import { memberNetRowHtml, memberHistoryRowHtml, MEMBER_NET_ROWS, MEMBER_HISTORY_ROWS } from "../../lib/ui/index.ts";
    import { FILER_CHANGES_ROWS, filerChangeRowHtml } from "../../lib/ui/institutional.ts";
    import { TICKER_HOLDER_HELD } from "../../lib/ui/ticker.ts";
    import { initNotes } from "../../scripts/notes";
    /* R15: a tail filer's Position changes "Show more" is a DOM-backed
       disclosure; the driver dispatches `populus:rerender` after each render.
       Rule 8 (LD26): a budget-cut member's body holds its net-flow and
       filing-history rows in islands, rendered by the same row functions. */
    registerHeldRows(MEMBER_NET_ROWS, memberNetRowHtml);
    registerHeldRows(MEMBER_HISTORY_ROWS, memberHistoryRowHtml);
    /* launch M7b (R33): a tail ticker's holders 26..N, in the same binder —
       its list is bound when the driver's render announces itself */
    registerHeldRows(TICKER_HOLDER_HELD.render, TICKER_HOLDER_HELD.row, { text: TICKER_HOLDER_HELD.text });
    /* a tail filer's Position changes past the compact twenty (rule 8, R35) */
    registerHeldRows(FILER_CHANGES_ROWS, filerChangeRowHtml);
    initDomDisclosures();
    runGenericRoute();
    // launch M1c (R12): tips open as bottom sheets at ≤720px here too
    initNotes();
  </script>
</Base>
