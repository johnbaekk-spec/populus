---
import Base from "../../layouts/Base.astro";
import { getBuildData, coverageSummary, feedPartsPlan, pct } from "../../lib/data";
import {
  DESIGN_FEED_PAGE_SIZE,
  pageSlice,
  pageCountFor,
  feedCountText,
  feedHeadHtml,
  feedItemHtml,
  footnoteBlock,
  note,
  type RenderCtx,
} from "../../lib/format";
import { congressTickersRollup, leadersRollup } from "../../lib/derive";
import { congressRankingSection, disclosureLedger, markPairPrimary, monthlyFlowPanel, rankingAlternatives, CONGRESS_ROOTS, type BuildStamps } from "../../lib/ui/index.ts";
import { congressLedgerFigures, congressLedgerItems } from "../../lib/ui/rankings.ts";
import { serializeInlineJson } from "../../lib/inline-json";
import { COMPACT_ROWS } from "../../lib/format";
import { feedItemHasTicker, planTickerOffsets, TICKER_VIEW_NOUN } from "../../lib/feed-parts";

const build = getBuildData();
const coverage = coverageSummary(build.stats);
/* R12 / LD7: the part index rides inline so paging costs only the part that
   holds the page — the same plan the /congress/data/feed/ routes emit. */
const partsIndex = feedPartsPlan(build).index;
/* Launch M3a (LD20, pagination-and-counts.md rule 2b): the "With ticker"
   default view pages by ticker position; its offsets ride inline beside the
   part index, from the SAME plan, with the whole-set totals I7 states. */
const tickerOffsets = planTickerOffsets(build.merged, partsIndex);
/* Launch M3b (R18, LD18): the compact ledger — Trades, Last 30 days, Median
   lag with the share filed late, and E-filings read — every figure computed
   from the build's rows and coverage (`congressLedgerFigures`), each with its
   denominators in its note. "E-filings read" is the site's floored `pct` over
   both chambers' e-filings; the paper count stays visible in its sub. */
const ledgerFigures = congressLedgerFigures(build.txns, { buildDate: build.generatedAtDate, filedFrom: build.filedFrom });
const ledgerHtml = disclosureLedger(
  congressLedgerItems(
    ledgerFigures,
    {
      ...coverage,
      efilePct: pct(coverage.houseParsed + coverage.senateParsed, coverage.houseEfile + coverage.senateEfile),
    },
    pct,
  ),
  { scope: "congress-ledger" },
);
/* The page's one "how to read" tip (the mock's H1 tip): the 45-day window,
   ranges, both dates, late flags, receipts and the owner codes. */
const readTip = note(
  "Members disclose trades up to 45 days after they happen, as a dollar range, never an exact amount. Every row keeps both dates, flags late filings and links to its source document. Trades by a spouse (SP), dependent child (DC) or joint account (JT) are filed under the member.",
  { scope: "congress-head" },
  "read",
  { trigger: "mark", textHtml: "ⓘ", name: "How to read this page" },
);

/* The momentum section's SSR view is AUTHORITATIVE, not a placeholder.
   It is rendered here at the locked defaults — a trailing 12 months on the
   traded basis — through the same functions the client calls, so the two
   cannot disagree. The client recomputes only when the reader changes the
   range or the basis. */
const MOMENTUM_RANGE = "12m" as const;
const MOMENTUM_BASIS = "traded" as const;

const stamps: BuildStamps = {
  buildId: build.buildId,
  generatedAt: build.generatedAt,
  generatedAtDate: build.generatedAtDate,
};

// SSR page 1 of the DEFAULT view ("With ticker", LD20) through the same
// renderer and the same slice rule the client island uses.
const ssrCtx: RenderCtx = {
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
const tickerView = build.merged.filter(feedItemHasTicker);
const pageOne = pageSlice(tickerView, 0, DESIGN_FEED_PAGE_SIZE);
const partsIndexJson = serializeInlineJson(partsIndex);
const tickerOffsetsJson = serializeInlineJson(tickerOffsets);
const rowsHtml = pageOne.map((item) => feedItemHtml(item, ssrCtx)).join("\n");
const sectionCtx: RenderCtx = {
  referenceRankings: true,
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};

const momentumHtml = congressRankingSection(
  "tickers",
  congressTickersRollup(build.txns, build.generatedAtDate, {
    range: MOMENTUM_RANGE,
    basis: MOMENTUM_BASIS,
  }),
  stamps,
  sectionCtx,
  {
    rootId: CONGRESS_ROOTS.momentum,
    heading: "Tickers",
    sectionId: "momentum-section",
    controls: true,
    compact: COMPACT_ROWS,
    /* Computed here because only this page holds the full row set —
       the rollup above is already windowed. The client recomputes the same
       thing from the same rows through the same function when the reader
       changes the window. */
    alternatives: rankingAlternatives(
      build.txns,
      build.generatedAtDate,
      "tickers",
      MOMENTUM_RANGE,
      MOMENTUM_BASIS,
    ),
  },
);

const membersHtml = congressRankingSection(
  "leaders",
  leadersRollup(build.txns, build.generatedAtDate, { range: "12m", basis: "traded" }),
  stamps,
  sectionCtx,
  {
    rootId: CONGRESS_ROOTS.membersRanked,
    undisclosedRootId: CONGRESS_ROOTS.membersUndisclosed,
    heading: "Members",
    sectionId: "members-section",
    compact: COMPACT_ROWS,
  },
);
/* SIGNALS-CLARITY M3 (R16–R19): 36 trade months of purchases vs sales, both
   variants (listed stocks, the default, and all asset types) built here from
   the full row set; `congress-sections.ts` flips `hidden` between them with no
   fetch (L4) — launch F2: the views not shown at load ride as island data and
   are drawn on first use. The build date is the window end and the
   completeness clock. */
const monthlyFlowHtml = monthlyFlowPanel(build.txns, build.generatedAtDate);
/* Launch M3a (copy item congress-27, adapted): the † on an unjoined filer is
   the trigger of its own note on the row it marks, so its footnote line is
   retired. The ‡ line stays: the per-row ‡ note's wording is frozen by the D7
   ruling (ledger-system.test.ts), so this line is the page's only statement
   of the Senate spouse cap. */
const footnoteHtml = footnoteBlock(
  [
    {
      mark: "‡",
      html: `Senate spouse amounts above $1M print only as "Over $1,000,000"`,
    },
  ],
  { id: "feed-footnote", layout: "inline" },
);
// The count is assembled by the same function the client island uses, so the
// pre-rendered and re-rendered counts cannot drift. I7: the default view
// states, as whole-set figures, the transactions without a ticker and the
// paper filings it hides, and where they are.
const rangeText = feedCountText({
  page: 0,
  pageSize: DESIGN_FEED_PAGE_SIZE,
  txnMatched: tickerOffsets.ticker_total,
  paperMatched: 0,
  txnOnPage: pageOne.filter((i) => i.kind === "txn").length,
  paperOnPage: 0,
  txnTotal: tickerOffsets.ticker_total,
  indeterminate: 0,
  view: {
    noun: TICKER_VIEW_NOUN,
    hiddenNoTicker: tickerOffsets.no_ticker_total,
    hiddenPaper: tickerOffsets.paper_total,
  },
});
// Whether a second page exists is a property of this build, not an assumption:
// a reduced extract must not pre-render an "older →" that goes nowhere.
const hasOlderPage = pageCountFor(tickerView, DESIGN_FEED_PAGE_SIZE) > 1;

const description =
  "Congressional stock trading from primary sources — House Clerk PTRs and Senate eFD. " +
  "Both dates on every trade, statutory amount ranges, provenance links, published imperfection.";
---

<Base title="Congressional trading — Public Filings" description={description} active="congress">
  <main
    class="shell page design-page"
    id="congress-page"
    data-txn-count={build.txnCount}
    data-generated-at-date={build.generatedAtDate}
    data-compact-limit={String(COMPACT_ROWS)}
    data-range={MOMENTUM_RANGE}
    data-basis={MOMENTUM_BASIS}
  >
    <!-- page header (launch M3b: the kicker is cut, the lede is one line, and
         the 45-day, ranges, dates and owner-code reading lives in one tip) -->
    <div class="page-head">
      <div class="page-head-copy">
        <h1 class="page-title">Congress</h1>
        <p class="page-lede">Every trade members of Congress disclose, as filed. <Fragment set:html={readTip} /></p>
      </div>
      <Fragment set:html={ledgerHtml} />
    </div>
    <div class="design-provenance">
      Filed up to 45 days after the trade · amounts are statutory ranges
        <div class="stamp-line" id="congress-stamp">
          As of {build.generatedAt} · House Clerk + Senate eFD
        </div>
        <details class="method-links" id="congress-method-links"><summary>Method</summary><div>
          <a href="/methodology/#defaults">Amendments ↗</a>
          <a href="/methodology/#coverage">Coverage ↗</a>
          <a href="/methodology/#amount-ranges">Ranges ↗</a>
          <a href="/methodology/#filing-lag">45-day lag ↗</a>
          <a href="/methodology/#owner-codes">Owner codes ↗</a>
        </div></details>
    </div>
    <!-- Launch M3b (R19): the Members and Tickers boards lead the page as two
         top-10 boards; "Show 50 more" expands each in place. The briefing
         cards and their "Notes on this data" drawer are retired (R22); Monthly
         flow closes the page (R21). -->
    <div class="design-rankings" id="congress-leaders-band"><Fragment set:html={markPairPrimary(membersHtml)} /><Fragment set:html={momentumHtml} /></div>

    <!-- filter bar. The controls live in their own wrapper so they can become a
         horizontal scroll strip on mobile WITHOUT taking the count line — which
         carries the indeterminate-amount disclosure, the privacy statement and
         the reset control — out of view with them. `display: contents` keeps
         the desktop layout exactly as designed. -->
    <section class="panel panel-wide" id="feed-section" aria-label="Disclosure feed">
      <div class="panel-head"><h2 class="section-h">Disclosure feed</h2>
        <span class="panel-note">newest filed first</span></div>
    <div class="filterbar" id="filterbar">
      <div class="filter-controls">
      <!-- Launch M3a (LD20): the view and the two quick filters lead; the text
           filter stands on its own row; Party, Amount, Owner, Late, Dates and
           the EXCHANGE side stay under More filters (DV17). Launch F2 (SC5):
           as in the approved mock, the quick groups carry no visible label
           (each group keeps its aria-label) and the text filter's label is
           the search glyph, its words in the placeholder. -->
      <div class="filter-quick">
      <div class="filter-group" role="group" aria-label="Rows">
        <div class="seg">
          <button data-group="view" data-value="ticker" aria-pressed="true">With ticker</button>
          <button data-group="view" data-value="all" aria-pressed="false">All rows</button>
        </div>
      </div>
      <div class="filter-group" role="group" aria-label="Side">
        <div class="seg">
          <button data-group="side" data-value="all" aria-pressed="true">All</button>
          <button data-group="side" data-value="buy" aria-pressed="false">Buys</button>
          <button data-group="side" data-value="sell" aria-pressed="false">Sells</button>
        </div>
      </div>
      <div class="filter-group" role="group" aria-label="Chamber">
        <div class="seg">
          <button data-group="chamber" data-value="all" aria-pressed="true">Both</button>
          <button data-group="chamber" data-value="house" aria-pressed="false">House</button>
          <button data-group="chamber" data-value="senate" aria-pressed="false">Senate</button>
        </div>
      </div>
      </div>
      <div class="filter-group filter-search">
        <label class="filter-label" for="filter-q"><span aria-hidden="true">⌕</span></label>
        <input
          class="filter-select filter-text"
          type="search"
          id="filter-q"
          placeholder="Filter by member or ticker"
          aria-label="filter by ticker prefix or member name — on this device"
        />
      </div>
      <details class="advanced-filters" id="advanced-filters"><summary>More filters</summary><div class="advanced-filter-body">
      <div class="filter-group" role="group" aria-label="Party">
        <span class="filter-label" aria-hidden="true">Party</span>
        <div class="seg">
          <button data-group="party" data-value="all" aria-pressed="true">All</button>
          <button data-group="party" data-value="D" class="tint-dem" aria-pressed="false" aria-label="Democratic">D</button>
          <button data-group="party" data-value="R" class="tint-rep" aria-pressed="false" aria-label="Republican">R</button>
          <button data-group="party" data-value="I" class="tint-ind" aria-pressed="false" aria-label="Independent">I</button>
        </div>
      </div>
      <div class="filter-group" role="group" aria-label="Exchanges">
        <span class="filter-label" aria-hidden="true">Side</span>
        <div class="seg">
          <!-- the feed's own kind word; pressing it again returns to All -->
          <button data-group="side" data-value="exch" aria-pressed="false">EXCHANGE</button>
        </div>
      </div>
      <div class="filter-group">
        <label class="filter-label" for="filter-amount">Amount ≥</label>
        <select class="filter-select" id="filter-amount">
          <option value="0" selected>any bucket</option>
          <option value="15000">≥ $15K</option>
          <option value="50000">≥ $50K</option>
          <option value="100000">≥ $100K</option>
          <option value="250000">≥ $250K</option>
          <option value="500000">≥ $500K</option>
          <option value="1000000">≥ $1M</option>
          <option value="5000000">≥ $5M</option>
          <option value="25000000">≥ $25M</option>
          <option value="50000000">≥ $50M</option>
        </select>
      </div>
      <div class="filter-group">
        <label class="filter-label" for="filter-owner">Owner</label>
        <select class="filter-select" id="filter-owner">
          <option value="all" selected>all</option>
          <option value="self">self</option>
          <option value="spouse">spouse (SP)</option>
          <option value="child">child (DC)</option>
          <option value="joint">joint (JT)</option>
          <option value="none">not stated</option>
        </select>
      </div>
      <label class="filter-check" for="filter-late">
        <input type="checkbox" id="filter-late" aria-label="late filings only" />
        late only
      </label>
      <div class="filter-group">
        <label class="filter-label" for="filter-date-basis">Dates</label>
        <select class="filter-select" id="filter-date-basis" aria-label="date basis for the range filter">
          <option value="filed" selected>filed</option>
          <option value="traded">traded</option>
        </select>
        <input class="filter-select" type="date" id="filter-date-from" aria-label="from date" />
        <span aria-hidden="true">–</span>
        <input class="filter-select" type="date" id="filter-date-to" aria-label="to date" />
      </div>
      </div></details>
      </div>
      <div class="filter-count">
        <span id="filter-count-line">{rangeText}</span>{" · filtered on this device"}<span
          id="filter-reset-wrap"
          hidden>{" · "}<button class="linklike" id="filter-reset">reset</button></span>
        <noscript>{" · filters and paging need JavaScript — full data at "}<a href="/congress/data/">congress/data</a></noscript>
      </div>
    </div>

    <!-- Section two: the disclosure feed. Ticker sits before Member and
         carries the primary emphasis; the default order remains newest filed
         (owner decision) — the visual anchor changed, the ordering did not. -->
    <div class="feed" id="congress-feed" data-txn-count={build.txnCount}>

      <div class="feed-loading" id="feed-loading" hidden aria-hidden="true">
        <div class="bar" style="width:88%"></div>
        <div class="bar" style="width:76%; animation-delay:0.15s"></div>
        <div class="bar" style="width:82%; animation-delay:0.3s"></div>
        <div class="bar" style="width:64%; animation-delay:0.45s"></div>
      </div>

      <div class="feed-empty" id="feed-empty" hidden>
        <h2>No disclosures match these filters.</h2>
        <p id="feed-empty-detail"></p>
        <div class="suggestions" id="feed-empty-suggestions"></div>
      </div>

      <!-- Not a scroll region (DESIGN-POLISH M1, R3): the ledger feed is page-flow
           rows, so the wrapper carries no focus stop and no "scroll" name. -->
      <div class="reference-feed-scroll">
      <table class="feed-table reference-feed" role="table" data-card="feed">
        <caption class="visually-hidden">
          Disclosed congressional transactions, newest filed first. Sort by clicking a column
          header; amounts sort on their disclosed lower bound and wholly-undisclosed rows are
          listed after every ranked row rather than treated as zero.
        </caption>
        <!-- ONE column contract (`feedHeadHtml`), shared with the rows
             `feedItemHtml` renders here and in the feed island; a second
             hand-written copy here would be free to drift from the cells. -->
        <Fragment set:html={feedHeadHtml({ activeKey: "filed", activeDir: "desc", notes: { scope: "congress-feed" } })} />


        <tbody id="feed-tbody" role="rowgroup" set:html={rowsHtml} />
      </table>
      </div>

      <Fragment set:html={footnoteHtml} />
      <!-- Launch F2 (SC5, copy item congress-23's pager): the count is stated
           once on screen, by the count line above the table; the pager's
           range keeps the same string for assistive technology and as the
           focus target after paging (I6), visually hidden at every width as
           it already was on desktop. -->
      <!-- The feed's compact bound is its PAGE, and the pager below is
           the disclosure that lifts it. A second "show all" control over a
           20-row page of ~60,000 rows would be a control that cannot honour
           its own label; the pager states the bound and moves through it. -->
      <div class="feed-foot">
        <div class="pager">
          <span class="pager-range visually-hidden" id="pager-range" tabindex="-1">{rangeText}</span>
          <button class="pager-btn is-unavailable" id="pager-newer" aria-disabled="true">← Prev</button>
          <button
            class:list={["pager-btn", { "is-unavailable": !hasOlderPage }]}
            id="pager-older"
            aria-disabled={hasOlderPage ? "false" : "true"}>Next →</button
          >
        </div>
      </div>
      <!-- Live region kept outside the mobile-hidden count line, so filter
           results are announced on every viewport. -->
      <p class="visually-hidden" id="feed-status" role="status" aria-live="polite"></p>
    </div>
    </section>

    <!-- Launch M3b (R21): Monthly flow closes the page. -->
    <Fragment set:html={monthlyFlowHtml} />

    <script is:inline type="application/json" id="feed-parts-index" set:html={partsIndexJson} />
    <script is:inline type="application/json" id="feed-ticker-offsets" set:html={tickerOffsetsJson} />
  </main>

  <script>
    /* ONE fetch, ONE decode. The feed island owns both and hands the
       parsed rows to the ranking sections — they never fetch. */
    import { initFeed } from "../../scripts/feed-client";
    import { initCongressSections } from "../../scripts/congress-sections";
    import { initNotes } from "../../scripts/notes";
    /* R12: the full dataset is loaded LAZILY — the ranking sections ask
       the feed island for it (`requestRows`) the first time a control needs
       every row; page 1 and paging come from the byte-bounded parts. */
    let feed: ReturnType<typeof initFeed> | null = null;
    const sections = initCongressSections({ requestRows: () => void feed?.loadAll() });
    /* `onSettled` fires on BOTH the success and failure paths, so the
       momentum section's "applying …" state clears either way. Cleared only in
       `onRows` it would survive a failed download for the life of the page. */
    feed = initFeed({ onRows: sections.receiveRows, onSettled: sections.feedSettled });
    /* One `initNotes()` per surface that passes a note scope. Binding
       is DELEGATED on `document`, so one call covers notes created later by an
       `innerHTML` replacement — a sort repaint, a page change, a period switch —
       and a second call would be idempotent. It is NOT added to `Base.astro`:
       that would load the module on every page in the site, including the ones
       this run does not touch, for no benefit. Without it a note still OPENS,
       through `popovertarget` alone; what this adds is placement, hover, Escape
       and outside-click. */
    initNotes();
  </script>
</Base>

<style>
  /* the reset control renders as an inline link inside the mono count line */
  .linklike {
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
  }
  .linklike:hover {
    color: var(--accent-h);
  }
</style>
