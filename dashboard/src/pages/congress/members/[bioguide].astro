---
// Congress Member entity page — the ENTITY archetype of
// docs/frontend/design-principles.md §7 (member / 13F filer / company are one
// template). Body rendered by the
// same pure ui.ts function the generic client route uses — parity by
// construction. Static paths: every member in the extract minus budget cuts
// (the budget-cut rule); cut members stay reachable at /e/?k=m:… with their endpoint.
import Base from "../../../layouts/Base.astro";
import { getBuildData, getSignalArtifact, sectorResolver, chamberBenchmarkFor } from "../../../lib/data";
import { memberBody, memberSignalsPanel, signalKindShort, type BuildStamps, type MemberV2Deps } from "../../../lib/ui/index.ts";
import type { RenderCtx } from "../../../lib/format";

export function getStaticPaths() {
  const build = getBuildData();
  return build.members
    .filter((m) => !build.cutMembers.has(m.bioguide))
    .map((m) => ({ params: { bioguide: m.bioguide } }));
}

const { bioguide } = Astro.params;
const build = getBuildData();
const member = build.membersByKey.get(bioguide!)!;
const signalArtifact = getSignalArtifact();
const stamps: BuildStamps = {
  buildId: build.buildId,
  generatedAt: build.generatedAt,
  generatedAtDate: build.generatedAtDate,
};
const ssrCtx: RenderCtx = {
  cutMembers: build.cutMembers,
  cutTickers: build.cutTickers,
};
// C-3 (ALPHA-UX): the v2 sections — net flow by ticker, sector mix, largest
// recent, committee jurisdiction overlap — with honest absence for the B-5/
// B-6 context until a build carries those tables.
const v2Deps: MemberV2Deps = {
  resolveSector: sectorResolver(build),
  sectorMeta: build.sectorData
    ? { taxonomyVersion: build.sectorData.taxonomyVersion, asOf: build.sectorData.asOf }
    : null,
  committees: build.committeeData
    ? {
        memberships: build.committeeData.byMember.get(member.bioguide) ?? [],
        windowFrom: build.committeeData.windowFrom,
        windowTo: build.committeeData.windowTo,
        jurisdictionByCommittee: build.committeeData.jurisdictionByCommittee,
        mappingVersion: build.committeeData.mappingVersion,
        snapshotDate: build.committeeData.snapshotDate,
      }
    : null,
  chamber: chamberBenchmarkFor(build, member.chamber),
  /* R23 / LD24: the compact layout's Signals fact reads the member's ACTIVE
     signals of any kind (s1–s6) from the same artifact the panel reads */
  signals: {
    retentionDays: signalArtifact.retentionDays,
    active: signalArtifact.signals
      .filter((s) => s.entities.bioguide === member.bioguide && s.status === "active")
      .map((s) => ({ kind: s.kind, label: `S-${s.kind.slice(1, 2)} · ${signalKindShort(s.kind)}`, ticker: s.entities.ticker ?? null })),
    /* launch review H4: "None" is stated with what was not evaluated */
    unevaluated: signalArtifact.signals.filter((s) => s.entities.bioguide === member.bioguide && s.status === "unevaluated").length,
    withheld: signalArtifact.withheld.map((w) => `S-${w.kind.slice(1, 2)} · ${signalKindShort(w.kind)}`),
  },
};
const bodyHtml =
  memberBody(member, stamps, ssrCtx, 0, v2Deps, memberSignalsPanel(signalArtifact, member.bioguide, ssrCtx));
const description =
  `Congressional financial disclosures for ${member.name}: every transaction as filed, ` +
  `statutory amount ranges, dual dates, provenance links — from primary government sources.`;
---

<Base title={`${member.name} — congressional disclosures — Public Filings`} description={description} active="congress">
  <main class="shell page entity-page" data-entity-kind="m" data-entity-key={member.bioguide}>
    <Fragment set:html={bodyHtml} />
  </main>
  <script>
    import { initEntityPage } from "../../../scripts/entity-client";
    import { initNotes } from "../../../scripts/notes";
    import { initDomDisclosures, registerHeldRows } from "../../../scripts/inst-index-client";
    import { memberNetRowHtml, memberHistoryRowHtml, MEMBER_NET_ROWS, MEMBER_HISTORY_ROWS } from "../../../lib/ui/index.ts";
    initEntityPage();
    /* R36 + rule 8 (LD26): the member page's compact tables (net disclosed
       flow by ticker, filing history) hold their extra rows in JSON islands;
       the one binder renders them through the SAME row functions the server
       used, registered here by the names the islands carry. */
    registerHeldRows(MEMBER_NET_ROWS, memberNetRowHtml);
    registerHeldRows(MEMBER_HISTORY_ROWS, memberHistoryRowHtml);
    initDomDisclosures();
    /* One `initNotes()` per surface that passes a note scope. Binding
       is DELEGATED on `document`, so one call covers notes created later by an
       `innerHTML` replacement — a sort repaint, a page change, a period switch —
       and a second call would be idempotent. It is NOT added to `Base.astro`:
       that would load the module on every page in the site, including the ones
       this run does not touch, for no benefit. Without it a note still OPENS,
       through `popovertarget` alone; what this adds is placement, hover, Escape
       and outside-click. */
    initNotes();
  </script>
</Base>
