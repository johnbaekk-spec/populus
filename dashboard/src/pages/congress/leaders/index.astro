---
/* Retired sub-tab route, served as a STATIC HTML redirect artifact.

   NOT an `_redirects` entry. The published-path verification contract fetches
   every inventoried path with redirects disabled and compares the bytes it
   gets against the bytes it expects; an injected redirect response is a
   FAILURE there, so an HTTP redirect would break publication verification for
   a path that must keep returning real content.

   So this page returns 200 with a real document that does three things, in
   descending order of reliability: a canonical link naming the merged page for
   crawlers, a meta refresh for browsers, and a VISIBLE link that works with
   scripting and refresh both disabled. The visible link is the one that is
   never allowed to be missing — a redirect nobody can follow by hand is a dead
   end, not a redirect. */
import Base from "../../../layouts/Base.astro";

const target = "/congress/#members-section";
const description =
  "The Congress leaders view is now a section of the single /congress/ page — this page links to it.";
---

<Base
  title="Congress leaders — moved to /congress/ — Public Filings"
  description={description}
  active="congress"
  head={`<link rel="canonical" href="/congress/" /><meta http-equiv="refresh" content="0; url=${target}" />`}
>
  <main class="shell page">
    <div class="page-head">
      <div class="page-head-copy">
        <h1 class="page-title">This view moved</h1>
        <!-- Launch M3b (copy item stub-01): one line and a visible link that
             works with scripting and refresh both disabled. -->
        <p class="page-lede">Member rankings are now on the Congress page.</p>
        <p class="page-lede">
          <a class="stub-link" href={target}>Go to Members →</a>
        </p>
      </div>
    </div>
  </main>
</Base>
