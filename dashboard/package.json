{
  "name": "populus-dashboard",
  "version": "0.0.1",
  "private": true,
  "description": "Public Filings public dashboard \u2014 Astro static site built from the published data build (ARCHITECTURE \u00a712).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:bounded": "node -e 'const {totalmem}=require(\"node:os\"); if(totalmem()<34359738368){console.error(\"full build requires at least 32 GiB physical RAM\"); process.exit(1)}' && NODE_OPTIONS=--max-old-space-size=24576 astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"test/*.test.ts\"",
    "test:post": "NODE_OPTIONS=--max-old-space-size=24576 node --test --test-concurrency=1 \"test/post/*.test.ts\"",
    "geometry:install": "playwright install --with-deps chromium",
    "test:geometry": "playwright test",
    "gates": "npm run check && npm test && npm run build:bounded && npm run test:post && npm run geometry:install && npm run test:geometry && npm run test:holders-browser",
    "typecheck:slice-tests": "tsc --noEmit -p tsconfig.slice-tests.json",
    "test:holders-browser": "playwright test -c playwright.holders.config.ts",
    "fixture:holders-page": "bash test/fixtures/holders-preview.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/public-sans": "^5.2.5",
    "@fontsource/source-serif-4": "^5.2.5",
    "astro": "^7.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "wrangler": "4.60.0"
  },
  "overrides": {
    "wrangler": {
      "undici": "^7.29.0",
      "ws": "^8.20.2",
      "miniflare": {
        "sharp": "^0.35.0",
        "undici": "^7.29.0",
        "ws": "^8.20.2"
      }
    }
  }
}
